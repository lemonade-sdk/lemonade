include(${CMAKE_CURRENT_LIST_DIR}/CxxStringLiterals.cmake)

function(_lemon_embedded_definition out symbol path)
    file(READ "${path}" _text)
    string(FIND "${_text}" ")definition\"" _delimiter)
    if(NOT _delimiter EQUAL -1)
        message(FATAL_ERROR "${path}: byte ${_delimiter}: contains the raw string delimiter )definition\", which would end the embedded ${symbol} literal early")
    endif()
    lemon_cxx_raw_string_literals(_literals definition "${path}: ${symbol}" "${_text}")
    set(${out} "inline constexpr char ${symbol}[] = ${_literals};\n" PARENT_SCOPE)
endfunction()

function(_lemon_backend_definition_symbol out path)
    get_filename_component(_name "${path}" NAME)
    string(REGEX REPLACE "\\.json$" "" _stem "${_name}")
    if(NOT _stem MATCHES "^[a-z][a-z0-9_]*$")
        message(FATAL_ERROR "${path}: the file name must be <stem>.json with <stem> matching [a-z][a-z0-9_]*, because it names k_<stem>_definition")
    endif()
    set(${out} k_${_stem}_definition PARENT_SCOPE)
endfunction()

function(lemon_backend_definition_version out path)
    file(READ "${path}" _json)
    string(JSON _type ERROR_VARIABLE _error TYPE "${_json}" schema_version)
    if(_error OR NOT _type STREQUAL "NUMBER")
        message(FATAL_ERROR "${path}: /schema_version: expected integer 1 or 2")
    endif()
    string(JSON _version GET "${_json}" schema_version)
    if(NOT _version STREQUAL "1" AND NOT _version STREQUAL "2")
        message(FATAL_ERROR "${path}: /schema_version: unsupported envelope version ${_version}")
    endif()
    set(${out} "${_version}" PARENT_SCOPE)
endfunction()

function(lemon_backend_definition_id out path)
    file(READ "${path}" _json)
    string(JSON _type ERROR_VARIABLE _error TYPE "${_json}" id)
    if(_error OR NOT _type STREQUAL "STRING")
        message(FATAL_ERROR "${path}: /id: expected definition identifier")
    endif()
    string(JSON _id GET "${_json}" id)
    if(NOT _id MATCHES "^[a-z][a-z0-9._-]*$")
        message(FATAL_ERROR "${path}: /id: invalid definition identifier")
    endif()
    lemon_cxx_raw_string_literals(_literal sourceid "${path}: /id" "${_id}")
    set(${out} "${_literal}" PARENT_SCOPE)
endfunction()

function(lemon_backend_definition_resources out schema_path)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${schema_path}" ${ARGN})
    _lemon_embedded_definition(_resources k_backend_definition_schema "${schema_path}")
    set(_source_bytes 0)
    set(_source_count 0)
    set(_v1_bytes 0)
    set(_v2_bytes 0)
    set(_v1_count 0)
    set(_v2_count 0)
    foreach(_path IN LISTS ARGN)
        lemon_backend_definition_version(_version "${_path}")
        file(SIZE "${_path}" _size)
        math(EXPR _v${_version}_bytes "${_v${_version}_bytes} + ${_size}")
        math(EXPR _v${_version}_count "${_v${_version}_count} + 1")
        math(EXPR _source_bytes "${_source_bytes} + ${_size}")
        math(EXPR _source_count "${_source_count} + 1")
        _lemon_backend_definition_symbol(_symbol "${_path}")
        _lemon_embedded_definition(_resource ${_symbol} "${_path}")
        string(APPEND _resources "${_resource}")
    endforeach()
    string(APPEND _resources "inline constexpr unsigned long long k_backend_definition_source_bytes = ${_source_bytes};\ninline constexpr unsigned k_backend_definition_source_count = ${_source_count};\n")
    foreach(_version 1 2)
        string(APPEND _resources "inline constexpr unsigned long long k_backend_definition_v${_version}_source_bytes = ${_v${_version}_bytes};\ninline constexpr unsigned k_backend_definition_v${_version}_source_count = ${_v${_version}_count};\n")
    endforeach()
    set(${out} "${_resources}" PARENT_SCOPE)
endfunction()

function(lemon_backend_definition_resource_index out schema_path)
    set(_index "    {R\"path(${schema_path})path\", k_backend_definition_schema, sizeof(k_backend_definition_schema) - 1},\n")
    foreach(_path IN LISTS ARGN)
        _lemon_backend_definition_symbol(_symbol "${_path}")
        string(APPEND _index "    {R\"path(${_path})path\", ${_symbol}, sizeof(${_symbol}) - 1},\n")
    endforeach()
    set(${out} "${_index}" PARENT_SCOPE)
endfunction()

function(lemon_backend_definition_v2_resources out schema_path)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${schema_path}")
    _lemon_embedded_definition(_resource k_backend_definition_v2_schema "${schema_path}")
    set(${out} "${_resource}" PARENT_SCOPE)
endfunction()

function(lemon_backend_builtin_source_resources out)
    set(_resources "#pragma once\n#include \"backend_definition_resources.h\"\n#include \"lemon/backends/configured/backend_definition_composition.h\"\nnamespace lemon::backends {\ninline const std::vector<DefinitionSourceView>& builtin_source_views() {\n    static const std::vector<DefinitionSourceView> sources{\n")
    foreach(_path IN LISTS ARGN)
        lemon_backend_definition_version(_version "${_path}")
        if(_version EQUAL 2)
            lemon_backend_definition_id(_id_literal "${_path}")
            _lemon_backend_definition_symbol(_symbol "${_path}")
            string(APPEND _resources "        {{DefinitionNamespace::Builtin, ${_id_literal}, 1}, ${_symbol}, {}},\n")
        endif()
    endforeach()
    string(APPEND _resources "    };\n    return sources;\n}\n}\n")
    set(${out} "${_resources}" PARENT_SCOPE)
endfunction()
