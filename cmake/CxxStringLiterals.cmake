set(LEMON_CXX_LITERAL_BUDGET 8000)

function(lemon_cxx_literal_within_budget context length)
    if(length GREATER LEMON_CXX_LITERAL_BUDGET)
        message(FATAL_ERROR "${context}: emits a ${length}-byte string literal, over the ${LEMON_CXX_LITERAL_BUDGET}-byte budget per literal (MSVC rejects a literal over 16380 bytes with C2026)")
    endif()
endfunction()

function(_lemon_cxx_raw_cut out context text offset)
    set(_cut ${LEMON_CXX_LITERAL_BUDGET})
    set(_steps 0)
    while(TRUE)
        string(SUBSTRING "${text}" ${_cut} 1 _byte)
        string(HEX "${_byte}" _hex)
        if(NOT _hex MATCHES "^[89ab]")
            break()
        endif()
        if(_steps EQUAL 3)
            math(EXPR _at "${offset} + ${_cut}")
            message(FATAL_ERROR "${context}: byte ${_at}: not valid UTF-8, so the literal has no character boundary to split at")
        endif()
        math(EXPR _cut "${_cut} - 1")
        math(EXPR _steps "${_steps} + 1")
    endwhile()
    math(EXPR _before "${_cut} - 1")
    string(SUBSTRING "${text}" ${_before} 1 _byte)
    if(_byte STREQUAL "\r")
        set(_cut ${_before})
    endif()
    set(${out} ${_cut} PARENT_SCOPE)
endfunction()

function(lemon_cxx_raw_string_literals out delimiter context text)
    string(LENGTH "${text}" _remaining)
    set(_offset 0)
    set(_literals "")
    while(TRUE)
        if(_remaining GREATER LEMON_CXX_LITERAL_BUDGET)
            string(SUBSTRING "${text}" 0 ${LEMON_CXX_LITERAL_BUDGET} _window)
            string(FIND "${_window}" "\n" _newline REVERSE)
            if(_newline EQUAL -1)
                _lemon_cxx_raw_cut(_cut "${context}" "${text}" ${_offset})
            else()
                math(EXPR _cut "${_newline} + 1")
            endif()
        else()
            set(_cut ${_remaining})
        endif()
        string(SUBSTRING "${text}" 0 ${_cut} _chunk)
        string(LENGTH "${_chunk}" _length)
        lemon_cxx_literal_within_budget("${context}" ${_length})
        string(APPEND _literals "R\"${delimiter}(${_chunk})${delimiter}\"")
        if(_cut EQUAL _remaining)
            break()
        endif()
        string(APPEND _literals "\n")
        string(SUBSTRING "${text}" ${_cut} -1 text)
        math(EXPR _remaining "${_remaining} - ${_cut}")
        math(EXPR _offset "${_offset} + ${_cut}")
    endwhile()
    set(${out} "${_literals}" PARENT_SCOPE)
endfunction()
