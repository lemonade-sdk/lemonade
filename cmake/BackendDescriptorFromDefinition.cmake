# cmake/BackendDescriptorFromDefinition.cmake
# Emit a BackendDescriptor initializer from a backend definition's metadata block.

if(CMAKE_VERSION VERSION_LESS 3.19)
    message(FATAL_ERROR "Generating backend descriptors from definitions needs string(JSON), available from CMake 3.19")
endif()

include(${CMAKE_CURRENT_LIST_DIR}/CxxStringLiterals.cmake)

set(_LEMON_DESCRIPTOR_METADATA_KEYS
    display_name binary config_section default_device slot_policy selectable_backend
    uses_ctx_size dynamic_models options support supported_modes required_checkpoints
    default_capabilities web_display_name rocm_channels exposes_prometheus_metrics
    rocm_requires_cwsr_fix version_policy self_manages_downloads takes_args arg_variants
    bin_variants config_extra streams_model_from_storage)
set(_LEMON_SERVER_METADATA_KEYS server_name log_category log_level_policy)
set(_LEMON_DESCRIPTOR_OPTION_KEYS name cli_flag default_value type_name help group)
set(_LEMON_CONTRACT_OPTION_KEYS value_type enum minimum maximum unset_values ui)
set(_LEMON_DESCRIPTOR_SUPPORT_KEYS backend tier format supported_os devices device_summary arch_gates)

function(_lemon_definition_fail where message)
    message(FATAL_ERROR "${_lemon_definition_path}: ${where}: ${message}")
endfunction()

function(_lemon_definition_member out_type out_value json key)
    string(JSON _type ERROR_VARIABLE _error TYPE "${json}" "${key}")
    if(_error)
        set(${out_type} "" PARENT_SCOPE)
        set(${out_value} "" PARENT_SCOPE)
        return()
    endif()
    string(JSON _value GET "${json}" "${key}")
    set(${out_type} "${_type}" PARENT_SCOPE)
    set(${out_value} "${_value}" PARENT_SCOPE)
endfunction()

function(_lemon_definition_keys json where)
    string(JSON _count LENGTH "${json}")
    if(_count EQUAL 0)
        return()
    endif()
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE ${_last})
        string(JSON _key MEMBER "${json}" ${_index})
        if(NOT _key IN_LIST ARGN)
            _lemon_definition_fail("${where}/${_key}" "not a field the descriptor emitter knows")
        endif()
    endforeach()
endfunction()

function(_lemon_cxx_string out value where)
    string(ASCII 1 _first_control)
    string(ASCII 31 _last_control)
    string(ASCII 127 _delete)
    string(REPLACE "\\" "\\\\" _escaped "${value}")
    string(REPLACE "\"" "\\\"" _escaped "${_escaped}")
    string(REPLACE "\n" "\\n" _escaped "${_escaped}")
    string(REPLACE "\r" "\\r" _escaped "${_escaped}")
    string(REPLACE "\t" "\\t" _escaped "${_escaped}")
    string(REPLACE "?" "\\?" _escaped "${_escaped}")
    if(_escaped MATCHES "[${_first_control}-${_last_control}${_delete}]")
        _lemon_definition_fail("${where}" "contains a control character the emitter cannot write")
    endif()
    string(LENGTH "${_escaped}" _length)
    lemon_cxx_literal_within_budget("${_lemon_definition_path}: ${where}" ${_length})
    set(${out} "\"${_escaped}\"" PARENT_SCOPE)
endfunction()

function(_lemon_definition_string out json key where)
    cmake_parse_arguments(PARSE_ARGV 4 _arg "REQUIRED" "DEFAULT" "")
    _lemon_definition_member(_type _value "${json}" "${key}")
    if("${_type}" STREQUAL "")
        if(_arg_REQUIRED)
            _lemon_definition_fail("${where}/${key}" "required")
        endif()
        set(_value "${_arg_DEFAULT}")
    elseif(NOT "${_type}" STREQUAL "STRING")
        _lemon_definition_fail("${where}/${key}" "expected a string, found ${_type}")
    endif()
    _lemon_cxx_string(_literal "${_value}" "${where}/${key}")
    set(${out} "${_literal}" PARENT_SCOPE)
endfunction()

function(_lemon_definition_bool out json key where default)
    _lemon_definition_member(_type _value "${json}" "${key}")
    if("${_type}" STREQUAL "")
        set(_value ${default})
    elseif(NOT "${_type}" STREQUAL "BOOLEAN")
        _lemon_definition_fail("${where}/${key}" "expected a boolean, found ${_type}")
    endif()
    if(_value)
        set(${out} "true" PARENT_SCOPE)
    else()
        set(${out} "false" PARENT_SCOPE)
    endif()
endfunction()

function(_lemon_string_list out json where)
    string(JSON _count LENGTH "${json}")
    set(_items "")
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE ${_last})
            string(JSON _type TYPE "${json}" ${_index})
            if(NOT "${_type}" STREQUAL "STRING")
                _lemon_definition_fail("${where}/${_index}" "expected a string, found ${_type}")
            endif()
            string(JSON _value GET "${json}" ${_index})
            _lemon_cxx_string(_literal "${_value}" "${where}/${_index}")
            if(_index EQUAL 0)
                set(_items "${_literal}")
            else()
                string(APPEND _items ", ${_literal}")
            endif()
        endforeach()
    endif()
    set(${out} "{${_items}}" PARENT_SCOPE)
endfunction()

function(_lemon_definition_string_array out json key where)
    cmake_parse_arguments(PARSE_ARGV 4 _arg "REQUIRED" "DEFAULT" "")
    _lemon_definition_member(_type _value "${json}" "${key}")
    if("${_type}" STREQUAL "")
        if(_arg_REQUIRED)
            _lemon_definition_fail("${where}/${key}" "required")
        endif()
        set(_value "[]")
        if(DEFINED _arg_DEFAULT)
            set(_value "${_arg_DEFAULT}")
        endif()
    elseif(NOT "${_type}" STREQUAL "ARRAY")
        _lemon_definition_fail("${where}/${key}" "expected an array, found ${_type}")
    endif()
    _lemon_string_list(_literal "${_value}" "${where}/${key}")
    set(${out} "${_literal}" PARENT_SCOPE)
endfunction()

function(_lemon_definition_enum out json key where)
    cmake_parse_arguments(PARSE_ARGV 4 _arg "REQUIRED" "DEFAULT" "VALUES")
    _lemon_definition_member(_type _value "${json}" "${key}")
    if("${_type}" STREQUAL "")
        if(_arg_REQUIRED)
            _lemon_definition_fail("${where}/${key}" "required")
        endif()
        set(_value "${_arg_DEFAULT}")
    elseif(NOT "${_type}" STREQUAL "STRING")
        _lemon_definition_fail("${where}/${key}" "expected a string, found ${_type}")
    endif()
    set(_names "")
    foreach(_pair ${_arg_VALUES})
        string(FIND "${_pair}" "=" _split)
        string(SUBSTRING "${_pair}" 0 ${_split} _name)
        math(EXPR _start "${_split} + 1")
        string(SUBSTRING "${_pair}" ${_start} -1 _enumerator)
        if("${_value}" STREQUAL "${_name}")
            set(${out} "${_enumerator}" PARENT_SCOPE)
            return()
        endif()
        list(APPEND _names "${_name}")
    endforeach()
    list(JOIN _names ", " _expected)
    _lemon_definition_fail("${where}/${key}" "unknown value '${_value}'; expected one of ${_expected}")
endfunction()

function(_lemon_raw_json out text where)
    string(FIND "${text}" ")json\"" _delimiter)
    if(NOT _delimiter EQUAL -1)
        _lemon_definition_fail("${where}" "contains the raw string delimiter )json\"")
    endif()
    lemon_cxx_raw_string_literals(_literals json "${_lemon_definition_path}: ${where}" "${text}")
    set(${out} "nlohmann::json::parse(${_literals})" PARENT_SCOPE)
endfunction()

function(_lemon_json_value out type value where)
    if("${type}" STREQUAL "STRING")
        _lemon_cxx_string(_literal "${value}" "${where}")
    elseif("${type}" STREQUAL "BOOLEAN")
        if(value)
            set(_literal "true")
        else()
            set(_literal "false")
        endif()
    elseif("${type}" STREQUAL "NULL")
        set(_literal "nullptr")
    elseif("${type}" STREQUAL "NUMBER")
        set(_literal "nlohmann::json::parse(\"${value}\")")
    else()
        _lemon_raw_json(_literal "${value}" "${where}")
    endif()
    set(${out} "${_literal}" PARENT_SCOPE)
endfunction()

function(_lemon_descriptor_binary out metadata)
    _lemon_definition_member(_type _value "${metadata}" binary)
    if("${_type}" STREQUAL "STRING")
        _lemon_cxx_string(_literal "${_value}" "/metadata/binary")
        set(${out} "    d.binary = ${_literal};\n" PARENT_SCOPE)
        return()
    elseif("${_type}" STREQUAL "")
        _lemon_definition_fail("/metadata/binary" "required")
    elseif(NOT "${_type}" STREQUAL "OBJECT")
        _lemon_definition_fail("/metadata/binary" "expected a string or a per-OS object, found ${_type}")
    endif()
    _lemon_definition_keys("${_value}" "/metadata/binary" windows linux macos)
    foreach(_os windows linux macos)
        _lemon_definition_string(_binary_${_os} "${_value}" ${_os} "/metadata/binary" REQUIRED)
    endforeach()
    set(${out}
        "#ifdef _WIN32\n    d.binary = ${_binary_windows};\n#elif defined(__APPLE__)\n    d.binary = ${_binary_macos};\n#else\n    d.binary = ${_binary_linux};\n#endif\n"
        PARENT_SCOPE)
endfunction()

function(_lemon_descriptor_options out metadata)
    _lemon_definition_member(_type _options "${metadata}" options)
    if("${_type}" STREQUAL "")
        _lemon_definition_fail("/metadata/options" "required")
    elseif(NOT "${_type}" STREQUAL "ARRAY")
        _lemon_definition_fail("/metadata/options" "expected an array, found ${_type}")
    endif()
    string(JSON _count LENGTH "${_options}")
    set(_rows "")
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE ${_last})
            set(_where "/metadata/options/${_index}")
            string(JSON _option_type TYPE "${_options}" ${_index})
            if(NOT "${_option_type}" STREQUAL "OBJECT")
                _lemon_definition_fail("${_where}" "expected an object, found ${_option_type}")
            endif()
            string(JSON _option GET "${_options}" ${_index})
            _lemon_definition_keys("${_option}" "${_where}" ${_LEMON_DESCRIPTOR_OPTION_KEYS} ${_LEMON_CONTRACT_OPTION_KEYS})
            _lemon_definition_string(_name "${_option}" name "${_where}" REQUIRED)
            _lemon_definition_string(_cli_flag "${_option}" cli_flag "${_where}")
            _lemon_definition_member(_default_type _default "${_option}" default_value)
            if("${_default_type}" STREQUAL "")
                _lemon_definition_fail("${_where}/default_value" "required")
            endif()
            _lemon_json_value(_default_value "${_default_type}" "${_default}" "${_where}/default_value")
            _lemon_definition_string(_type_name "${_option}" type_name "${_where}")
            _lemon_definition_string(_help "${_option}" help "${_where}")
            _lemon_definition_string(_group "${_option}" group "${_where}")
            string(APPEND _rows "        {${_name}, ${_cli_flag}, ${_default_value}, ${_type_name}, ${_help}, ${_group}},\n")
        endforeach()
    endif()
    if("${_rows}" STREQUAL "")
        set(${out} "    d.options = {};\n" PARENT_SCOPE)
    else()
        set(${out} "    d.options = {\n${_rows}    };\n" PARENT_SCOPE)
    endif()
endfunction()

function(_lemon_support_devices out row where)
    _lemon_definition_member(_type _devices "${row}" devices)
    if("${_type}" STREQUAL "")
        _lemon_definition_fail("${where}/devices" "required")
    elseif(NOT "${_type}" STREQUAL "OBJECT")
        _lemon_definition_fail("${where}/devices" "expected an object, found ${_type}")
    endif()
    string(JSON _count LENGTH "${_devices}")
    set(_entries "")
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE ${_last})
            string(JSON _device MEMBER "${_devices}" ${_index})
            _lemon_definition_string_array(_families "${_devices}" "${_device}" "${where}/devices" REQUIRED)
            _lemon_cxx_string(_device_literal "${_device}" "${where}/devices/${_device}")
            if(_index GREATER 0)
                string(APPEND _entries ", ")
            endif()
            string(APPEND _entries "{${_device_literal}, ${_families}}")
        endforeach()
    endif()
    set(${out} "{${_entries}}" PARENT_SCOPE)
endfunction()

function(_lemon_support_arch_gates out row where)
    _lemon_definition_member(_type _gates "${row}" arch_gates)
    if("${_type}" STREQUAL "")
        set(${out} "{}" PARENT_SCOPE)
        return()
    elseif(NOT "${_type}" STREQUAL "OBJECT")
        _lemon_definition_fail("${where}/arch_gates" "expected an object, found ${_type}")
    endif()
    string(JSON _count LENGTH "${_gates}")
    set(_entries "")
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE ${_last})
            string(JSON _arch MEMBER "${_gates}" ${_index})
            set(_gate_where "${where}/arch_gates/${_arch}")
            string(JSON _gate_type TYPE "${_gates}" "${_arch}")
            if(NOT "${_gate_type}" STREQUAL "OBJECT")
                _lemon_definition_fail("${_gate_where}" "expected an object, found ${_gate_type}")
            endif()
            string(JSON _gate GET "${_gates}" "${_arch}")
            _lemon_definition_keys("${_gate}" "${_gate_where}" os channels)
            _lemon_definition_string_array(_os "${_gate}" os "${_gate_where}" REQUIRED)
            _lemon_definition_string_array(_channels "${_gate}" channels "${_gate_where}" REQUIRED)
            _lemon_cxx_string(_arch_literal "${_arch}" "${_gate_where}")
            if(_index GREATER 0)
                string(APPEND _entries ", ")
            endif()
            string(APPEND _entries "{${_arch_literal}, {${_os}, ${_channels}}}")
        endforeach()
    endif()
    set(${out} "{${_entries}}" PARENT_SCOPE)
endfunction()

function(_lemon_descriptor_support out metadata)
    _lemon_definition_member(_type _support "${metadata}" support)
    if("${_type}" STREQUAL "")
        set(_support "[]")
    elseif(NOT "${_type}" STREQUAL "ARRAY")
        _lemon_definition_fail("/metadata/support" "expected an array, found ${_type}")
    endif()
    string(JSON _count LENGTH "${_support}")
    set(_rows "")
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE ${_last})
            set(_where "/metadata/support/${_index}")
            string(JSON _row_type TYPE "${_support}" ${_index})
            if(NOT "${_row_type}" STREQUAL "OBJECT")
                _lemon_definition_fail("${_where}" "expected an object, found ${_row_type}")
            endif()
            string(JSON _row GET "${_support}" ${_index})
            _lemon_definition_keys("${_row}" "${_where}" ${_LEMON_DESCRIPTOR_SUPPORT_KEYS})
            _lemon_definition_string(_backend "${_row}" backend "${_where}" REQUIRED)
            _lemon_definition_enum(_tier "${_row}" tier "${_where}" REQUIRED VALUES
                core=BackendTier::Core experimental=BackendTier::Experimental guest=BackendTier::Guest)
            _lemon_definition_enum(_format "${_row}" format "${_where}" REQUIRED VALUES
                native=BackendFormat::Native python=BackendFormat::Python container=BackendFormat::Container)
            _lemon_definition_string_array(_supported_os "${_row}" supported_os "${_where}" REQUIRED)
            _lemon_support_devices(_devices "${_row}" "${_where}")
            _lemon_definition_string(_device_summary "${_row}" device_summary "${_where}" REQUIRED)
            _lemon_support_arch_gates(_arch_gates "${_row}" "${_where}")
            string(APPEND _rows "        {${_backend}, ${_tier}, ${_format}, ${_supported_os}, ${_devices}, ${_device_summary}, ${_arch_gates}},\n")
        endforeach()
    endif()
    if("${_rows}" STREQUAL "")
        set(${out} "    d.support = {};\n" PARENT_SCOPE)
    else()
        set(${out} "    d.support = {\n${_rows}    };\n" PARENT_SCOPE)
    endif()
endfunction()

function(_lemon_descriptor_config_extra out metadata)
    _lemon_definition_member(_type _extra "${metadata}" config_extra)
    if("${_type}" STREQUAL "")
        set(_extra "{}")
    elseif(NOT "${_type}" STREQUAL "OBJECT")
        _lemon_definition_fail("/metadata/config_extra" "expected an object, found ${_type}")
    endif()
    string(JSON _count LENGTH "${_extra}")
    if(_count EQUAL 0)
        set(${out} "nlohmann::json::object()" PARENT_SCOPE)
    else()
        _lemon_raw_json(_literal "${_extra}" "/metadata/config_extra")
        set(${out} "${_literal}" PARENT_SCOPE)
    endif()
endfunction()

# Sets <out> to the C++ definition of lemon::backends::<stem>::descriptor built
# from <definition_path>'s metadata. Fails the configure step on anything the
# descriptor cannot represent rather than defaulting it.
function(lemon_backend_descriptor_from_definition out stem recipe definition_path)
    set(_lemon_definition_path "${definition_path}")
    file(READ "${definition_path}" _definition)
    string(JSON _root_type ERROR_VARIABLE _parse_error TYPE "${_definition}")
    if(_parse_error)
        string(REGEX MATCH "Line [0-9]+, Column [0-9]+.*" _parse_location "${_parse_error}")
        if(_parse_location)
            set(_parse_error "${_parse_location}")
        endif()
        _lemon_definition_fail("/" "not valid JSON: ${_parse_error}")
    endif()
    _lemon_definition_member(_recipe_type _recipe "${_definition}" recipe)
    if(NOT "${_recipe_type}" STREQUAL "STRING" OR NOT "${_recipe}" STREQUAL "${recipe}")
        _lemon_definition_fail("/recipe" "expected \"${recipe}\" to match LEMON_BACKENDS, found '${_recipe}'")
    endif()
    _lemon_definition_member(_metadata_type metadata "${_definition}" metadata)
    if(NOT "${_metadata_type}" STREQUAL "OBJECT")
        _lemon_definition_fail("/metadata" "expected an object")
    endif()
    _lemon_definition_keys("${metadata}" "/metadata" ${_LEMON_DESCRIPTOR_METADATA_KEYS} ${_LEMON_SERVER_METADATA_KEYS})

    set(_m "/metadata")
    _lemon_cxx_string(_recipe_literal "${_recipe}" "/recipe")
    _lemon_definition_string(_display_name "${metadata}" display_name ${_m} REQUIRED)
    _lemon_descriptor_binary(_binary "${metadata}")
    _lemon_definition_string(_config_section "${metadata}" config_section ${_m})
    _lemon_definition_enum(_default_device "${metadata}" default_device ${_m} DEFAULT gpu VALUES
        cpu=DEVICE_CPU gpu=DEVICE_GPU npu=DEVICE_NPU none=DEVICE_NONE)
    _lemon_definition_enum(_slot_policy "${metadata}" slot_policy ${_m} DEFAULT standard VALUES
        standard=SlotPolicy::Standard exclusive_npu=SlotPolicy::ExclusiveNpu
        coexist_by_type=SlotPolicy::CoexistByType unmetered=SlotPolicy::Unmetered)
    _lemon_definition_bool(_selectable_backend "${metadata}" selectable_backend ${_m} OFF)
    _lemon_definition_bool(_uses_ctx_size "${metadata}" uses_ctx_size ${_m} OFF)
    _lemon_definition_bool(_dynamic_models "${metadata}" dynamic_models ${_m} OFF)
    _lemon_descriptor_options(_options "${metadata}")
    _lemon_descriptor_support(_support "${metadata}")
    _lemon_definition_string_array(_supported_modes "${metadata}" supported_modes ${_m} DEFAULT [=[["chat"]]=])
    _lemon_definition_string_array(_required_checkpoints "${metadata}" required_checkpoints ${_m} DEFAULT [=[["main"]]=])
    _lemon_definition_string_array(_default_capabilities "${metadata}" default_capabilities ${_m})
    _lemon_definition_string(_web_display_name "${metadata}" web_display_name ${_m})
    _lemon_definition_string_array(_rocm_channels "${metadata}" rocm_channels ${_m})
    _lemon_definition_bool(_exposes_prometheus_metrics "${metadata}" exposes_prometheus_metrics ${_m} OFF)
    _lemon_definition_bool(_rocm_requires_cwsr_fix "${metadata}" rocm_requires_cwsr_fix ${_m} OFF)
    _lemon_definition_enum(_version_policy "${metadata}" version_policy ${_m} DEFAULT exact VALUES
        exact=VersionPolicy::Exact at_least=VersionPolicy::AtLeast)
    _lemon_definition_bool(_self_manages_downloads "${metadata}" self_manages_downloads ${_m} OFF)
    _lemon_definition_bool(_takes_args "${metadata}" takes_args ${_m} OFF)
    _lemon_definition_string_array(_arg_variants "${metadata}" arg_variants ${_m})
    _lemon_definition_string_array(_bin_variants "${metadata}" bin_variants ${_m})
    _lemon_descriptor_config_extra(_config_extra "${metadata}")
    _lemon_definition_bool(_streams_model_from_storage "${metadata}" streams_model_from_storage ${_m} OFF)

    set(${out} "namespace lemon::backends::${stem} {

inline const BackendDescriptor descriptor = [] {
    BackendDescriptor d;
    d.recipe = ${_recipe_literal};
    d.display_name = ${_display_name};
${_binary}    d.config_section = ${_config_section};
    d.default_device = ${_default_device};
    d.slot_policy = ${_slot_policy};
    d.selectable_backend = ${_selectable_backend};
    d.uses_ctx_size = ${_uses_ctx_size};
    d.dynamic_models = ${_dynamic_models};
${_options}${_support}    d.supported_modes = ${_supported_modes};
    d.required_checkpoints = ${_required_checkpoints};
    d.default_capabilities = ${_default_capabilities};
    d.web_display_name = ${_web_display_name};
    d.rocm_channels = ${_rocm_channels};
    d.exposes_prometheus_metrics = ${_exposes_prometheus_metrics};
    d.rocm_requires_cwsr_fix = ${_rocm_requires_cwsr_fix};
    d.version_policy = ${_version_policy};
    d.self_manages_downloads = ${_self_manages_downloads};
    d.takes_args = ${_takes_args};
    d.arg_variants = ${_arg_variants};
    d.bin_variants = ${_bin_variants};
    d.config_extra = ${_config_extra};
    d.streams_model_from_storage = ${_streams_model_from_storage};
    return d;
}();

}

" PARENT_SCOPE)
endfunction()

function(lemon_backend_descriptor_v2_initializer OUTPUT STEM RESOLVED_EXPRESSION)
    if(NOT STEM MATCHES "^[a-z][a-z0-9_]*$")
        message(FATAL_ERROR "Invalid v2 descriptor symbol: ${STEM}")
    endif()
    set(${OUTPUT} "namespace lemon::backends::${STEM} {
inline const BackendDescriptor descriptor = descriptor_from_declaration(
    (${RESOLVED_EXPRESSION}).declaration, DefinitionNamespace::Builtin, DescriptorPlatform::native());
}
" PARENT_SCOPE)
endfunction()

function(lemon_backend_descriptor_dispatch out stem recipe path)
    lemon_backend_definition_version(_version "${path}")
    if(_version EQUAL 1)
        lemon_backend_descriptor_from_definition(_descriptor ${stem} ${recipe} "${path}")
    else()
        file(READ "${path}" _json)
        string(JSON _recipe GET "${_json}" recipe)
        if(NOT _recipe STREQUAL recipe)
            message(FATAL_ERROR "${path}: /recipe: expected ${recipe}")
        endif()
        lemon_backend_definition_id(_id_literal "${path}")
        lemon_backend_descriptor_v2_initializer(_descriptor ${stem}
            "builtin_resolved_source({DefinitionNamespace::Builtin, ${_id_literal}, 1})")
    endif()
    set(${out} "${_descriptor}" PARENT_SCOPE)
endfunction()

function(lemon_backend_registration_seed includes entry capability stem path)
    if(EXISTS "${path}")
        lemon_backend_definition_version(_version "${path}")
    else()
        set(_version 0)
    endif()
    set(_descriptor "&lemon::backends::${stem}::descriptor")
    if(_version EQUAL 2)
        lemon_backend_definition_id(_id_literal "${path}")
        set(_includes "")
        set(_entry "        { ${_descriptor}, ${_id_literal}, {} },\n")
        set(_mask "0")
        if(stem STREQUAL "llamacpp")
            set(_mask "lemon::CAP_EMBEDDINGS | lemon::CAP_RERANKING")
        endif()
        set(_capability "        { ${_descriptor}, ${_mask} },\n")
    else()
        set(_includes "#include \"lemon/backends/${stem}/${stem}_server.h\"\n")
        set(_configured "nullptr")
        if(_version EQUAL 1)
            set(_configured "lemon::backends::${stem}::configured_entry().get()")
        endif()
        set(_entry "        { ${_descriptor}, {}, { ${_descriptor}, &lemon::backends::${stem}::create, lemon::backends::${stem}::spec(), lemon::backends::${stem}::ops(), ${_configured} } },\n")
        set(_capability "        { ${_descriptor}, lemon::backends::${stem}::capabilities() },\n")
    endif()
    set(${includes} "${_includes}" PARENT_SCOPE)
    set(${entry} "${_entry}" PARENT_SCOPE)
    set(${capability} "${_capability}" PARENT_SCOPE)
endfunction()
