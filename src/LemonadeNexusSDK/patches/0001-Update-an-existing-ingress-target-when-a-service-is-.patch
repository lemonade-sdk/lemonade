From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Michael Anthony Falabella <falabellamichael@gmail.com>
Date: Sat, 24 Oct 2026 15:30:57 -0700
Subject: [PATCH 1/2] Update an existing ingress target when a service is
 re-registered

ns_add_tcp_forward on a virtual endpoint that already has a listener now replaces its target for new connections instead of failing, so a host can move the service behind a virtual port.
---
 crates/virtual-netstack/src/lib.rs                   |  1 +
 crates/virtual-netstack/src/stack.rs                 | 12 ++++++++----
 .../include/LemonadeNexusSDK/BoringtunMesh.hpp       |  1 +
 3 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/crates/virtual-netstack/src/lib.rs b/crates/virtual-netstack/src/lib.rs
index 5def6ab..6f44716 100644
--- a/crates/virtual-netstack/src/lib.rs
+++ b/crates/virtual-netstack/src/lib.rs
@@ -335,6 +335,7 @@ pub unsafe extern "C" fn ns_feed_inbound(handle: *mut NsHandle, pkt: *const u8,
 
 /// Add an ingress forward: virtual `vip:vport` -> bridge `target`.
 /// `target` is "tcp:127.0.0.1:PORT" or "unix:/path".
+/// Re-registering an endpoint replaces the target for subsequent connections.
 ///
 /// # Safety
 /// `handle` valid; string args NUL-terminated UTF-8.
diff --git a/crates/virtual-netstack/src/stack.rs b/crates/virtual-netstack/src/stack.rs
index 9fbfc0e..f8f8f4d 100644
--- a/crates/virtual-netstack/src/stack.rs
+++ b/crates/virtual-netstack/src/stack.rs
@@ -217,11 +217,15 @@ impl Stack {
                     addr: Some(IpAddress::Ipv4(vip)),
                     port: vport,
                 };
+                let spec = match &target {
+                    BridgeTarget::Tcp(a) => format!("tcp:{a}"),
+                    BridgeTarget::Unix(p) => format!("unix:{p}"),
+                };
+                if let Some(listener) = self.listeners.iter_mut().find(|l| l.endpoint == endpoint) {
+                    listener.target_spec = spec;
+                    return true;
+                }
                 if let Some(handle) = self.new_listening_socket(endpoint) {
-                    let spec = match &target {
-                        BridgeTarget::Tcp(a) => format!("tcp:{a}"),
-                        BridgeTarget::Unix(p) => format!("unix:{p}"),
-                    };
                     self.listeners.push(Listener {
                         endpoint,
                         target_spec: spec,
diff --git a/projects/LemonadeNexusSDK/include/LemonadeNexusSDK/BoringtunMesh.hpp b/projects/LemonadeNexusSDK/include/LemonadeNexusSDK/BoringtunMesh.hpp
index 0512cf4..483a43d 100644
--- a/projects/LemonadeNexusSDK/include/LemonadeNexusSDK/BoringtunMesh.hpp
+++ b/projects/LemonadeNexusSDK/include/LemonadeNexusSDK/BoringtunMesh.hpp
@@ -54,6 +54,7 @@ public:
     /// Publish a local service at our mesh IP: virtual <mesh_ip>:vport is
     /// bridged to `target` ("tcp:127.0.0.1:PORT" or "unix:/path"), making it
     /// reachable by authorized mesh peers. Returns false if inactive / failed.
+    /// Re-registering a virtual port updates the target for new connections.
     bool tcp_ingress(uint16_t vport, const std::string& target);
 
     /// The dataplane's bound local UDP port (0 when inactive).
