+                while conn.bridge_readable && !conn.bridge_eof && socket.can_send() {
+                    let bridge = &mut conn.bridge;
+                    match socket.send(|space| match bridge.read(space) {
+                        Ok(n) => (n, Ok(n)),
+                        Err(e) => (0, Err(e)),
