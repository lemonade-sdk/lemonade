From e32071e532a6264840e0dbc45af65666b367bc31 Mon Sep 17 00:00:00 2001
From: Thom Hadfield <100659456+festeraeb@users.noreply.github.com>
Date: Sun, 8 Nov 2026 03:13:24 +0000
Subject: [PATCH 1/3] netstack: turn off Nagle and delayed ACK on mesh TCP
 sockets

smoltcp's defaults cost a round trip per short request: Nagle holds a write
until the previous one is acknowledged, and the peer waits 10 ms before
acknowledging. Through the lemond peer relay between two Arch servers on
1 GbE (P2P path): request latency p50 30.5 ms -> 13.3 ms; 16-64 MiB uploads
unchanged (22-28 MB/s both ways).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/virtual-netstack/src/stack.rs | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/crates/virtual-netstack/src/stack.rs b/crates/virtual-netstack/src/stack.rs
index 0c2bbb6..bc9d44c 100644
--- a/crates/virtual-netstack/src/stack.rs
+++ b/crates/virtual-netstack/src/stack.rs
@@ -255,6 +255,12 @@ impl Stack {
         let tx = tcp::SocketBuffer::new(vec![0u8; self.tcp_buffer]);
         let mut socket = tcp::Socket::new(rx, tx);
         socket.set_congestion_control(tcp::CongestionControl::Cubic);
+        // The mesh carries request/response traffic (API calls, streamed tokens), where smoltcp's
+        // defaults cost a round trip each: Nagle holds a short write until the previous one is
+        // acknowledged, and the peer delays that acknowledgement by 10 ms. Measured through the
+        // lemond peer relay between two servers: 30.5 ms -> 13.3 ms per request, bulk unchanged.
+        socket.set_nagle_enabled(false);
+        socket.set_ack_delay(None);
         socket
     }
 
