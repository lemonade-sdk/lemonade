From 6efc0d044cd29e1e67cfc1838fbe704a81592273 Mon Sep 17 00:00:00 2001
From: Thom Hadfield <100659456+festeraeb@users.noreply.github.com>
Date: Fri, 30 Oct 2026 21:13:17 +0000
Subject: [PATCH 1/2] Mesh port: the auto router re-sends once to the next
 device when the chosen one gives no answer

Today a dead Tier 3 device means 409/502 to the client even when another
device in the group has the same model loaded (measured on the CESARops test
network: 11 x 409 after one backend stop). With this change, for a model named
WITHOUT a device prefix, a forward that produced no response byte at all
(device not reachable, no bridge, bridge silent) is re-sent once to the
next-ranked device from the same probe. A request that named its device is
never moved, and a request the device started to answer is never repeated.
status() gains auto_failovers. proxy_request reports whether the device
answered; forward_to_node returns it.

Test: MeshPortTest.AutoRouterFailsOverOnceWhenTheChosenDeviceGivesNoAnswer.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../include/LemonadeNexusSDK/MeshPort.hpp     |  8 ++-
 projects/LemonadeNexusSDK/src/MeshPort.cpp    | 52 +++++++++++++++----
 projects/LemonadeNexusSDK/src/MeshProxy.cpp   |  4 +-
 projects/LemonadeNexusSDK/src/MeshProxy.hpp   |  2 +-
 4 files changed, 54 insertions(+), 12 deletions(-)

diff --git a/projects/LemonadeNexusSDK/include/LemonadeNexusSDK/MeshPort.hpp b/projects/LemonadeNexusSDK/include/LemonadeNexusSDK/MeshPort.hpp
index de55745..fb5de86 100644
--- a/projects/LemonadeNexusSDK/include/LemonadeNexusSDK/MeshPort.hpp
+++ b/projects/LemonadeNexusSDK/include/LemonadeNexusSDK/MeshPort.hpp
@@ -2,6 +2,7 @@
 
 #include <nlohmann/json.hpp>
 
+#include <atomic>
 #include <chrono>
 #include <condition_variable>
 #include <cstdint>
@@ -387,7 +388,10 @@ private:
                          const std::string& path);
     void serve_auto(const httplib::Request& req, httplib::Response& res,
                     const std::string& path, const std::string& peer_authorization);
-    void forward_to_node(const std::string& node_id, const std::string& path,
+    /// Returns false when the device produced no response at all (it is not a
+    /// reachable Tier 3 member, no bridge could be opened, or the bridge gave no
+    /// response byte); the auto router then tries the next device once.
+    bool forward_to_node(const std::string& node_id, const std::string& path,
                          const httplib::Request& req, httplib::Response& res,
                          const std::string& peer_authorization, const std::string& body);
     void forward_local(const std::string& path, const httplib::Request& req,
@@ -414,6 +418,8 @@ private:
     std::shared_ptr<MeshPortProxies> proxies_;
 
     mutable std::mutex state_mutex_;
+    /// Requests the auto router re-sent to another device after the chosen one gave no answer.
+    std::atomic<int> auto_failovers_{0};
     bool running_{false};
     uint16_t port_{0};
     std::string local_host_;    // local service host; empty for none
diff --git a/projects/LemonadeNexusSDK/src/MeshPort.cpp b/projects/LemonadeNexusSDK/src/MeshPort.cpp
index 0fdb185..1e60a22 100644
--- a/projects/LemonadeNexusSDK/src/MeshPort.cpp
+++ b/projects/LemonadeNexusSDK/src/MeshPort.cpp
@@ -1273,6 +1273,7 @@ nlohmann::json MeshPort::status() const {
     }
     return {
         {"running", running_},
+        {"auto_failovers", auto_failovers_.load()},
         {"port", running_ ? port_ : 0},
         {"scheme", tls ? "https" : "http"},
         {"local_domain", local_domain_},
@@ -1399,9 +1400,21 @@ void MeshPort::serve_auto(const httplib::Request& req, httplib::Response& res, c
         ? body["model"].get<std::string>() : std::string();
     const auto local_ids = local_model_ids(caller_authorization);
     auto route = mesh_port::auto_route(model, members, self, local_ids, {});
+    std::vector<MeshPortPeerModels> peers;
+    bool probed = false;
     if (route.target.empty() && route.status == 404) {
-        route = mesh_port::auto_route(model, members, self, local_ids, peer_models(members, self, peer_authorization));
-    }
+        peers = peer_models(members, self, peer_authorization);
+        probed = true;
+        route = mesh_port::auto_route(model, members, self, local_ids, peers);
+    }
+    // A model named without a device prefix may be served by several devices.
+    // When the chosen one gives no answer at all, the request is sent once more
+    // to the next-ranked device. A request that named its device is never
+    // moved: the caller chose. A request the device started to answer is never
+    // repeated either: proxy_request only reports "no answer" before the first
+    // response byte.
+    const bool named_device = model.find('/') != std::string::npos && route.model != model;
+    const bool may_fail_over = probed && !named_device && !route.target.empty() && route.target != "local";
     if (!route.refused.empty()) {
         std::string names;
         for (const auto& name : route.refused) names += (names.empty() ? "" : ", ") + name;
@@ -1417,13 +1430,32 @@ void MeshPort::serve_auto(const httplib::Request& req, httplib::Response& res, c
         forwarded = body.dump();
     }
     if (route.target != "local") {
-        forward_to_node(route.target, path, req, res, peer_authorization, forwarded);
+        if (forward_to_node(route.target, path, req, res, peer_authorization, forwarded) || !may_fail_over) return;
+        // The chosen device never answered. Drop it from this request's view
+        // and ask the ranking for the next device, once.
+        const std::string dead = route.target;
+        peers.erase(std::remove_if(peers.begin(), peers.end(),
+                                   [&dead](const MeshPortPeerModels& p) { return p.node_id == dead; }),
+                    peers.end());
+        const auto next = mesh_port::auto_route(model, members, self, local_ids, peers);
+        if (next.target.empty() || next.target == "local" || next.target == dead) return;  // nothing else serves it
+        spdlog::info("[MeshPort] auto: device {} gave no answer for {}; re-sending once to {}", dead, model,
+                     next.target);
+        ++auto_failovers_;
+        httplib::Response retry;
+        auto body_next = forwarded;
+        if (next.model != route.model) {
+            body["model"] = next.model;
+            body_next = body.dump();
+        }
+        forward_to_node(next.target, path, req, retry, peer_authorization, body_next);
+        res = std::move(retry);
         return;
     }
     forward_local(path, req, res, forwarded);
 }
 
-void MeshPort::forward_to_node(const std::string& node_id, const std::string& path, const httplib::Request& req,
+bool MeshPort::forward_to_node(const std::string& node_id, const std::string& path, const httplib::Request& req,
                                httplib::Response& res, const std::string& peer_authorization, const std::string& body) {
     std::vector<MeshPortMember> members;
     {
@@ -1434,12 +1466,12 @@ void MeshPort::forward_to_node(const std::string& node_id, const std::string& pa
     const auto target = mesh_port::forward_target(members, self, node_id);
     if (target.first != 0) {
         reply_error(res, target.first, target.second);
-        return;
+        return false;
     }
     const uint16_t port = backend_.open_egress ? backend_.open_egress(target.second, kMeshPortPeerServicePort) : 0;
     if (port == 0) {
         reply_error(res, 502, "Cannot open a mesh connection to that device");
-        return;
+        return false;
     }
     {
         std::lock_guard lock(state_mutex_);
@@ -1455,15 +1487,17 @@ void MeshPort::forward_to_node(const std::string& node_id, const std::string& pa
         backend_.close_egress(address, kMeshPortPeerServicePort);
         return backend_.open_egress(address, kMeshPortPeerServicePort);
     };
+    bool answered = false;
     if (req.is_multipart_form_data()) {
         const auto [type, encoded] = multipart_body(req);
         proxy_request(proxies_, "127.0.0.1", port, req, path, forwarded_headers(req, peer_authorization, type), encoded,
-                      res, reopen);
-        return;
+                      res, reopen, &answered);
+        return answered;
     }
     const auto type = req.has_header("Content-Type") ? req.get_header_value("Content-Type") : std::string();
     proxy_request(proxies_, "127.0.0.1", port, req, path, forwarded_headers(req, peer_authorization, type), body, res,
-                  reopen);
+                  reopen, &answered);
+    return answered;
 }
 
 void MeshPort::forward_local(const std::string& path, const httplib::Request& req, httplib::Response& res,
diff --git a/projects/LemonadeNexusSDK/src/MeshProxy.cpp b/projects/LemonadeNexusSDK/src/MeshProxy.cpp
index 6890687..edcccd6 100644
--- a/projects/LemonadeNexusSDK/src/MeshProxy.cpp
+++ b/projects/LemonadeNexusSDK/src/MeshProxy.cpp
@@ -185,7 +185,8 @@ bool pipe_answered(MeshProxyPipe& pipe) {
 
 void proxy_request(const std::shared_ptr<MeshPortProxies>& proxies, const std::string& host, uint16_t port,
                    const httplib::Request& req, const std::string& target, httplib::Headers headers,
-                   const std::string& body, httplib::Response& res, const std::function<uint16_t()>& reopen) {
+                   const std::string& body, httplib::Response& res, const std::function<uint16_t()>& reopen,
+                   bool* answered) {
     const auto started = std::chrono::steady_clock::now();
     auto pipe = start_pipe(proxies, host, port, req, target, headers, body);
     if (reopen && !pipe_answered(*pipe) && std::chrono::steady_clock::now() - started < kDeadBridgeWindow) {
@@ -212,6 +213,7 @@ void proxy_request(const std::shared_ptr<MeshPortProxies>& proxies, const std::s
         status = pipe->status;
         type = pipe->content_type;
     }
+    if (answered) *answered = ready;
     if (!ready) {
         pipe->cancel();
         pipe->join();
diff --git a/projects/LemonadeNexusSDK/src/MeshProxy.hpp b/projects/LemonadeNexusSDK/src/MeshProxy.hpp
index 1e2b2fb..fc3e062 100644
--- a/projects/LemonadeNexusSDK/src/MeshProxy.hpp
+++ b/projects/LemonadeNexusSDK/src/MeshProxy.hpp
@@ -132,6 +132,6 @@ inline constexpr std::chrono::seconds kDeadBridgeWindow{10};
 void proxy_request(const std::shared_ptr<MeshPortProxies>& proxies, const std::string& host, uint16_t port,
                    const httplib::Request& req, const std::string& target, httplib::Headers headers,
                    const std::string& body, httplib::Response& res,
-                   const std::function<uint16_t()>& reopen = {});
+                   const std::function<uint16_t()>& reopen = {}, bool* answered = nullptr);
 
 }  // namespace lnsdk
