{
  "id": "rocmfpx",
  "digest": "sha256:472e8c5f7d1ce55bf86ee05aff563a23e76c1082fa11e9d7b45c4905112d20c0",
  "semantics": {
    "kind": "container",
    "recipe": "rocmfpx",
    "containers": {
      "rocm": {
        "repository": "docker.io/kyuz0/amd-strix-halo-toolboxes",
        "pin": {
          "source": "backend_versions",
          "recipe": "rocmfpx",
          "backend": "rocm"
        },
        "devices": [
          "/dev/dri",
          "/dev/kfd"
        ],
        "cap_add": [],
        "policy": "lemonade-isolated-v1",
        "network": "private_internal",
        "teardown": "stop_remove_reap",
        "stop_grace_seconds": 10
      }
    },
    "install": {
      "strategy": "oci",
      "cases": []
    },
    "artifacts": {
      "main": {
        "role": "main",
        "strategy": "resolved_path",
        "missing_error": {
          "concat": [
            "GGUF file not found for checkpoint: ",
            {
              "ref": "/model/checkpoint"
            }
          ]
        },
        "check": "nonempty",
        "required_when": true
      },
      "mmproj": {
        "role": "mmproj",
        "strategy": "resolved_path",
        "required_when": false,
        "missing_error": "Optional model file is missing",
        "check": "nonempty"
      },
      "draft": {
        "role": "draft",
        "strategy": "resolved_path",
        "required_when": false,
        "missing_error": "Optional model file is missing",
        "check": "nonempty"
      }
    },
    "backend": {
      "fixed": "rocm"
    },
    "execution": {
      "cases": [
        {
          "id": "rocm-container",
          "backends": [
            "rocm"
          ],
          "kind": "container",
          "container": "rocm",
          "program": {
            "source": "image_command",
            "name": "llama-server"
          }
        }
      ]
    },
    "mounts": [
      {
        "id": "main",
        "artifact": "main",
        "expand": "gguf_shards",
        "destination": "/mnt/models",
        "layout": "basename_numbered"
      },
      {
        "id": "mmproj",
        "artifact": "mmproj",
        "expand": "gguf_shards",
        "destination": "/mnt/models",
        "layout": "basename_numbered",
        "when": {
          "not": {
            "eq": [
              {
                "ref": "/artifacts/mmproj"
              },
              ""
            ]
          }
        }
      },
      {
        "id": "draft",
        "artifact": "draft",
        "expand": "gguf_shards",
        "destination": "/mnt/models",
        "layout": "basename_numbered",
        "when": {
          "not": {
            "eq": [
              {
                "ref": "/artifacts/draft"
              },
              ""
            ]
          }
        }
      }
    ],
    "address": {
      "source": "process_start"
    },
    "environment": {
      "preset": "inherit",
      "set": [],
      "order": "preset_first"
    },
    "working_directory": "inherit",
    "protected_environment": [
      "HOME",
      "LD_PRELOAD",
      "LD_LIBRARY_PATH",
      "PATH",
      "HIP_VISIBLE_DEVICES",
      "ROCR_VISIBLE_DEVICES",
      "CUDA_VISIBLE_DEVICES"
    ],
    "confinement": "lemonade-isolated-v1",
    "diagnostics": {
      "records": [
        {
          "id": "loading",
          "phase": "loading",
          "level": "info",
          "category": "RocmFpx",
          "format": "Loading model: {model:string}",
          "when": "always"
        },
        {
          "id": "loaded",
          "phase": "success",
          "level": "debug",
          "category": "RocmFpx",
          "format": "Model loaded on port {loaded_port:integer}",
          "when": "always"
        }
      ],
      "prepare_order": [
        "backend",
        "install",
        "artifacts",
        "program",
        "ports"
      ],
      "category": "RocmFpx",
      "load_log_policy": "none",
      "options": [
        {
          "id": "args",
          "name": "rocmfpx_args",
          "cli_flag": "--rocmfpx-args",
          "default_value": "",
          "type_name": "ARGS",
          "value_type": "string",
          "help": "Custom arguments to pass to the ROCm FPX llama-server",
          "group": "ROCm FPX Options"
        }
      ],
      "custom_args": {
        "option": "args",
        "runtime_input": "string_or_empty",
        "reserved": [
          "-c",
          "--ctx-size",
          "-m",
          "--model",
          "-mu",
          "--model-url",
          "-hf",
          "-hfr",
          "-hff",
          "-mr",
          "-mf",
          "--hf-repo",
          "--hf-file",
          "-md",
          "--model-draft",
          "--spec-draft-model",
          "-mm",
          "--mmproj",
          "-mmu",
          "--mmproj-url",
          "--no-mmproj",
          "--host",
          "--port",
          "--jinja",
          "--no-jinja",
          "--metrics"
        ],
        "error_prefix": "Invalid custom ROCm FPX llama-server arguments:\n",
        "defaults": [
          {
            "id": "mtp",
            "args": "--spec-type draft-mtp",
            "flag": "--spec-type",
            "aliases": [],
            "stage": "runtime_options",
            "respect_merge_args": false,
            "when": {
              "ref": "/model/labels/mtp"
            }
          },
          {
            "id": "parallel",
            "args": "--parallel 1",
            "flag": "--parallel",
            "aliases": [
              "-np"
            ],
            "stage": "runtime_options",
            "respect_merge_args": false,
            "when": true
          },
          {
            "id": "batch",
            "args": "-b 2048",
            "flag": "-b",
            "aliases": [
              "--batch-size"
            ],
            "stage": "runtime_options",
            "respect_merge_args": false,
            "when": true
          },
          {
            "id": "ubatch",
            "args": "-ub 2048",
            "flag": "-ub",
            "aliases": [
              "--ubatch-size"
            ],
            "stage": "runtime_options",
            "respect_merge_args": false,
            "when": true
          }
        ]
      },
      "ports": [
        {
          "name": "http",
          "reject_zero": true,
          "error": "No HTTP port available"
        }
      ],
      "readiness": {
        "port": "http",
        "path": "/health",
        "timeout": "global"
      }
    },
    "direct_stream": {
      "policy": "builtin_container_legacy",
      "operations": [
        {
          "id": "chat.buffered",
          "operation": "chat_completion",
          "delivery": "buffered",
          "model_modes": [
            "*"
          ],
          "transport": {
            "kind": "http_json",
            "method": "POST",
            "path": "/v1/chat/completions",
            "port": "http",
            "timeout": "global",
            "response_codec": "json.v1"
          },
          "request": {
            "base": "identity",
            "hooks": [
              {
                "id": "llamacpp.max_tokens_alias",
                "params": {}
              },
              {
                "id": "llamacpp.tool_schema_limits",
                "params": {}
              }
            ],
            "remove": [],
            "set": {},
            "omit_missing": false
          },
          "response": {
            "hooks": [
              {
                "id": "llamacpp.client_model",
                "params": {}
              }
            ]
          }
        },
        {
          "id": "completion.buffered",
          "operation": "completion",
          "delivery": "buffered",
          "model_modes": [
            "*"
          ],
          "transport": {
            "kind": "http_json",
