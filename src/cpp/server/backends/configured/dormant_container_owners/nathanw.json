{
  "id": "nathanw",
  "digest": "sha256:74e821a50d34a06411afbd29215da72dcba8b01ed81f070e603b3206db4c548e",
  "semantics": {
    "kind": "container",
    "recipe": "llamacpp",
    "containers": {
      "nathanw": {
        "repository": "docker.io/kyuz0/amd-strix-halo-toolboxes",
        "pin": {
          "source": "backend_versions",
          "recipe": "llamacpp",
          "backend": "nathanw"
        },
        "devices": [
          "/dev/dri"
        ],
        "cap_add": [],
        "policy": "lemonade-isolated-v1",
        "network": "private_internal",
        "teardown": "stop_remove_reap",
        "stop_grace_seconds": 10
      }
    },
    "install": {
      "strategy": "oci",
      "cases": []
    },
    "artifacts": {
      "main": {
        "role": "main",
        "strategy": "resolved_path",
        "check": "nonempty",
        "required_when": {
          "not": {
            "ref": "/launch/hook/hf_load"
          }
        },
        "missing_error": {
          "concat": [
            "GGUF file not found for checkpoint: ",
            {
              "ref": "/model/checkpoint"
            }
          ]
        }
      },
      "mmproj": {
        "role": "mmproj",
        "strategy": "resolved_path",
        "check": "nonempty",
        "required_when": false,
        "missing_error": "Optional mmproj path is unavailable"
      },
      "draft": {
        "role": "draft",
        "strategy": "resolved_path",
        "check": "nonempty",
        "required_when": false,
        "missing_error": "Optional draft path is unavailable"
      }
    },
    "backend": {
      "fixed": "nathanw"
    },
    "execution": {
      "cases": [
        {
          "id": "nathanw",
          "backends": [
            "nathanw"
          ],
          "kind": "container",
          "container": "nathanw",
          "program": {
            "source": "image_command",
            "name": "llama-server"
          },
          "device_validation": {
            "backend": "vulkan"
          }
        }
      ]
    },
    "mounts": [
      {
        "id": "main",
        "artifact": "main",
        "expand": "gguf_shards",
        "destination": "/mnt/models",
        "layout": "basename_numbered"
      },
      {
        "id": "mmproj",
        "artifact": "mmproj",
        "expand": "gguf_shards",
        "destination": "/mnt/models",
        "layout": "basename_numbered",
        "when": {
          "ref": "/launch/hook/use_mmproj"
        }
      },
      {
        "id": "draft",
        "artifact": "draft",
        "expand": "gguf_shards",
        "destination": "/mnt/models",
        "layout": "basename_numbered",
        "when": {
          "ref": "/launch/hook/use_draft_checkpoint"
        }
      }
    ],
    "address": {
      "source": "process_start"
    },
    "environment": {
      "preset": "inherit",
      "set": [],
      "order": "preset_first"
    },
    "working_directory": "inherit",
    "protected_environment": [
      "HOME",
      "LD_PRELOAD",
      "LD_LIBRARY_PATH",
      "PATH",
      "HIP_VISIBLE_DEVICES",
      "ROCR_VISIBLE_DEVICES",
      "CUDA_VISIBLE_DEVICES"
    ],
    "confinement": "lemonade-isolated-v1",
    "diagnostics": {
      "records": [
        {
          "id": "loading",
          "phase": "loading",
          "level": "info",
          "category": "LlamaCpp",
          "format": "Loading model: {model:string}",
          "when": "always"
        },
        {
          "id": "settings",
          "phase": "loading",
          "level": "debug",
          "category": "LlamaCpp",
          "format": "Per-model settings: {settings:options}",
          "when": "always"
        },
        {
          "id": "backend",
          "phase": "backend",
          "level": "info",
          "category": "LlamaCpp",
          "format": "Using LlamaCpp Backend: {backend:string}",
          "when": "always"
        },
        {
          "id": "gguf",
          "phase": "artifacts",
          "level": "debug",
          "category": "LlamaCpp",
          "format": "Using GGUF: {main:path}",
          "when": "main_present"
        },
        {
          "id": "gpu",
          "phase": "arguments",
          "level": "debug",
          "category": "LlamaCpp",
          "format": "Using backend: {backend:string}\n[LlamaCpp] Use GPU: {gpu:boolean}",
          "when": "always"
        },
        {
          "id": "mmproj",
          "phase": "arguments",
          "level": "debug",
          "category": "LlamaCpp",
          "format": "Skipping mmproj argument since GPU mode is not enabled",
          "when": "mmproj_cpu"
        },
        {
          "id": "embedding",
          "phase": "arguments",
          "level": "info",
          "category": "LlamaCpp",
          "format": "Model supports embeddings, adding --embeddings flag",
          "when": "embedding"
        },
        {
          "id": "reranking",
          "phase": "arguments",
          "level": "info",
          "category": "LlamaCpp",
          "format": "Model supports reranking, adding --reranking flag",
          "when": "reranking"
        },
        {
          "id": "custom",
          "phase": "custom_args",
          "level": "debug",
          "category": "LlamaCpp",
          "format": "Adding custom arguments: {custom:string}",
          "when": "custom_present"
        },
        {
          "id": "starting",
          "phase": "starting",
          "level": "info",
          "category": "LlamaCpp",
          "format": "Starting llama-server...",
          "when": "always"
        },
        {
          "id": "loaded",
          "phase": "success",
          "level": "debug",
          "category": "LlamaCpp",
          "format": "Model loaded on port {loaded_port:integer}",
          "when": "always"
        }
      ],
      "prepare_order": [
        "backend",
        "install",
        "hook",
        "artifacts",
        "ports",
        "program"
      ],
      "category": "LlamaCpp",
      "load_log_policy": "none",
      "options": [
        {
          "id": "backend",
          "name": "llamacpp_backend",
          "cli_flag": "--llamacpp",
          "default_value": "",
          "type_name": "BACKEND",
          "value_type": "string",
          "help": "LlamaCpp backend to use",
          "group": "Llama.cpp Backend Options",
          "unset_values": [
            null,
            -1,
            "",
            "auto"
          ]
        },
        {
          "id": "device",
          "name": "llamacpp_device",
          "cli_flag": "--llamacpp-device",
          "default_value": "",
          "type_name": "DEVICES",
          "value_type": "string",
          "help": "Comma-separated list of accelerator devices to use (e.g. Vulkan0)",
          "group": "Llama.cpp Backend Options",
          "unset_values": [
            null,
            -1,
            "",
            "auto"
          ]
        },
        {
          "id": "args",
          "name": "llamacpp_args",
          "cli_flag": "--llamacpp-args",
          "default_value": "",
          "type_name": "ARGS",
          "value_type": "string",
          "help": "Custom arguments to pass to llama-server",
          "group": "Llama.cpp Backend Options",
          "unset_values": [
            null,
            -1,
            "",
            "auto"
          ]
        }
      ],
      "custom_args": {
        "option": "args",
        "reserved": [],
        "error_prefix": "Invalid custom llama-server arguments:\n",
        "defaults": [
          {
            "id": "spec-dflash",
            "args": "--spec-type draft-dflash",
            "flag": "--spec-type",
            "when": {
              "ref": "/runtime/dflash"
            },
            "stage": "runtime_options",
            "respect_merge_args": true,
            "aliases": []
          },
          {
            "id": "spec-mtp",
            "args": "--spec-type draft-mtp",
            "flag": "--spec-type",
            "when": {
              "ref": "/runtime/mtp"
            },
            "stage": "runtime_options",
            "respect_merge_args": true,
            "aliases": []
          },
          {
            "id": "parallel",
            "args": "--parallel 1",
            "flag": "--parallel",
            "aliases": [
              "-np"
            ],
            "stage": "runtime_options",
            "respect_merge_args": true,
            "when": true
          }
        ],
        "runtime_input": "string_or_empty"
      },
      "ports": [
        {
          "name": "http",
          "reject_zero": false,
          "error": ""
        }
      ],
      "readiness": {
        "port": "http",
        "path": "/health",
        "timeout": "global"
      }
    },
    "pre_install_refusal": {
      "policy": "container_hf_load_v1",
      "prepare_order": [
        "backend",
        "install",
        "hook",
        "artifacts",
        "ports",
        "program"
      ]
    },
    "direct_stream": {
