{
  "id": "ds4_rocm",
  "digest": "sha256:4b694ed3713311ea01e98e57177ae6574fff81e8d88e0b5624bfb5a0a463640d",
  "semantics": {
    "kind": "container",
    "recipe": "ds4",
    "containers": {
      "rocm": {
        "repository": "docker.io/kyuz0/strix-halo-ds4-toolbox",
        "pin": {
          "source": "backend_versions",
          "recipe": "ds4_rocm",
          "backend": "rocm"
        },
        "devices": [
          "/dev/dri",
          "/dev/kfd"
        ],
        "cap_add": [
          "SYS_PTRACE"
        ],
        "policy": "lemonade-isolated-v1",
        "network": "private_internal",
        "teardown": "stop_remove_reap",
        "stop_grace_seconds": 10
      }
    },
    "install": {
      "strategy": "oci",
      "cases": []
    },
    "artifacts": {
      "main": {
        "role": "main",
        "strategy": "resolved_path",
        "missing_error": {
          "concat": [
            "ds4: no local GGUF found for model '",
            {
              "ref": "/model/name"
            },
            "' (checkpoint: ",
            {
              "ref": "/model/checkpoint"
            },
            ")"
          ]
        },
        "absolute_checkpoint_fallback": true,
        "checkpoint_consumer": "builtin_container_absolute_v1",
        "required_when": true
      },
      "draft": {
        "role": "draft",
        "strategy": "resolved_path",
        "required_when": false,
        "missing_error": "Missing draft"
      }
    },
    "backend": {
      "fixed": "rocm"
    },
    "execution": {
      "cases": [
        {
          "id": "rocm-container",
          "backends": [
            "rocm"
          ],
          "kind": "container",
          "container": "rocm",
          "program": {
            "source": "image_command",
            "name": "ds4-server"
          },
          "memory_plan": "ds4_rocm_v1",
          "memory_phase": "after_ports"
        }
      ]
    },
    "mounts": [
      {
        "id": "main",
        "artifact": "main",
        "expand": "file",
        "destination": "/mnt/models",
        "layout": "basename_numbered"
      },
      {
        "id": "draft",
        "artifact": "draft",
        "expand": "file",
        "destination": "/mnt/models",
        "layout": "basename_numbered",
        "when": {
          "all": [
            {
              "ref": "/memory/resident"
            },
            {
              "not": {
                "eq": [
                  {
                    "ref": "/artifacts/draft"
                  },
                  ""
                ]
              }
            }
          ]
        }
      }
    ],
    "address": {
      "source": "process_start"
    },
    "environment": {
      "preset": "inherit",
      "set": [
        {
          "name": "DS4_ROCM_STREAM_MODEL_CACHE_GB",
          "value": {
            "string": {
              "ref": "/memory/model_cache_gb"
            }
          },
          "when": {
            "gt": [
              {
                "ref": "/memory/model_cache_gb"
              },
              0
            ]
          }
        },
        {
          "name": "DS4_ROCM_STREAM_FREE_RESERVE_GB",
          "value": {
            "string": {
              "ref": "/memory/free_reserve_gb"
            }
          },
          "when": {
            "all": [
              {
                "not": {
                  "ref": "/memory/resident"
                }
              },
              {
                "gt": [
                  {
                    "ref": "/memory/free_reserve_gb"
                  },
                  0
                ]
              }
            ]
          }
        }
      ],
      "order": "preset_first"
    },
    "working_directory": "inherit",
    "protected_environment": [
      "HOME",
      "LD_PRELOAD",
      "LD_LIBRARY_PATH",
      "PATH",
      "HIP_VISIBLE_DEVICES",
      "ROCR_VISIBLE_DEVICES",
      "CUDA_VISIBLE_DEVICES"
    ],
    "confinement": "lemonade-isolated-v1",
    "model_contract": "ds4_rocm_v1",
    "slot_policy": "standard",
    "content_transforms": [
      {
        "id": "chat.buffered",
        "transform": "ds4_no_think_v1"
      },
      {
        "id": "chat.buffered",
        "rewrite_domain": "chat_completions_substring"
      },
      {
        "id": "chat.streaming",
        "transform": "ds4_no_think_v1"
      },
      {
        "id": "chat.streaming",
        "rewrite_domain": "chat_completions_substring"
      }
    ],
    "diagnostics": {
      "records": [
        {
          "id": "custom",
          "phase": "custom_args",
          "level": "debug",
          "category": "DS4",
          "format": "Adding custom arguments: {custom:string}",
          "when": "custom_present"
        },
        {
          "id": "starting",
          "phase": "starting",
          "level": "info",
          "category": "DS4",
          "format": "Starting ds4-server ({image:string}) for {main:path} on port {port:integer}",
          "when": "always"
        }
      ],
      "prepare_order": [
        "backend",
        "artifacts",
        "install",
        "program",
        "ports"
      ],
      "category": "DS4",
      "load_log_policy": "none",
      "options": [
        {
          "id": "args",
          "name": "ds4_args",
          "cli_flag": "--ds4-args",
          "default_value": "",
          "type_name": "ARGS",
          "value_type": "string",
          "help": "Custom arguments to pass to ds4-server",
          "group": "DS4 Options"
        }
      ],
      "custom_args": {
        "option": "args",
        "reserved": [
          "-m",
          "--model",
          "--host",
          "--port",
          "-c",
          "--ctx",
          "--backend",
          "--cpu",
          "--metal",
          "--rocm",
          "--cuda"
        ],
        "error_prefix": "Invalid custom ds4-server arguments:\n",
        "defaults": []
      },
      "ports": [
        {
          "name": "http",
          "reject_zero": true,
          "error": "No HTTP port available"
        }
      ],
      "readiness": {
        "port": "http",
        "path": "/v1/models",
        "timeout": "global"
      }
    },
    "direct_stream": {
      "policy": "builtin_container_legacy",
      "operations": [
        {
          "id": "chat.buffered",
          "operation": "chat_completion",
          "delivery": "buffered",
          "model_modes": [
            "*"
          ],
          "transport": {
            "kind": "http_json",
            "method": "POST",
            "path": "/v1/chat/completions",
            "port": "http",
            "timeout": "global",
            "response_codec": "json.v1"
          },
          "request": {
            "base": "identity",
            "content_transform": "ds4_no_think_v1",
            "rewrite_domain": "chat_completions_substring",
            "remove": [],
            "set": {},
            "omit_missing": false
          }
        },
        {
          "id": "chat.streaming",
          "operation": "chat_completion",
          "delivery": "streaming",
          "model_modes": [
            "*"
          ],
          "transport": {
            "kind": "http_sse",
            "method": "POST",
            "path": "/v1/chat/completions",
            "port": "http",
            "timeout": "global",
            "stream_codec": "openai_sse.v1"
          },
          "request": {
            "base": "identity",
            "content_transform": "ds4_no_think_v1",
            "rewrite_domain": "chat_completions_substring",
            "remove": [],
            "set": {},
            "omit_missing": false
          }
        },
        {
          "id": "completion.buffered",
          "operation": "completion",
          "delivery": "buffered",
          "model_modes": [
            "*"
          ],
          "transport": {
            "kind": "http_json",
            "method": "POST",
            "path": "/v1/completions",
            "port": "http",
            "timeout": "global",
            "response_codec": "json.v1"
          },
          "request": {
            "base": "identity",
            "remove": [],
            "set": {},
            "omit_missing": false
          }
        },
        {
          "id": "completion.streaming",
          "operation": "completion",
          "delivery": "streaming",
          "model_modes": [
            "*"
          ],
          "transport": {
            "kind": "http_sse",
            "method": "POST",
            "path": "/v1/completions",
            "port": "http",
            "timeout": "global",
            "stream_codec": "openai_sse.v1"
          },
          "request": {
            "base": "identity",
            "remove": [],
            "set": {},
            "omit_missing": false
          }
        },
        {
          "id": "responses.buffered",
          "operation": "responses",
          "delivery": "buffered",
          "model_modes": [
            "*"
          ],
          "transport": {
            "kind": "http_json",
            "method": "POST",
            "path": "/v1/responses",
            "port": "http",
            "timeout": "global",
            "response_codec": "json.v1"
          },
          "request": {
            "base": "identity",
            "remove": [],
            "set": {},
            "omit_missing": false
          }
        },
        {
          "id": "responses.streaming",
          "operation": "responses",
          "delivery": "streaming",
          "model_modes": [
            "*"
          ],
          "transport": {
            "kind": "http_sse",
            "method": "POST",
            "path": "/v1/responses",
            "port": "http",
            "timeout": "global",
            "stream_codec": "openai_sse.v1"
          },
          "request": {
            "base": "identity",
            "remove": [],
            "set": {},
            "omit_missing": false
          }
        }
      ]
    }
  }
}
