{
  "schema_version": 1,
  "id": "ryzenai",
  "recipe": "ryzenai-llm",
  "kind": "local",
  "metadata": {
    "display_name": "Ryzen AI LLM",
    "server_name": "RyzenAI-Server",
    "log_category": "RyzenAI",
    "log_level_policy": "debug_flag",
    "binary": {
      "windows": "ryzenai-server.exe",
      "linux": "ryzenai-server",
      "macos": "ryzenai-server"
    },
    "config_section": "ryzenai",
    "default_device": "npu",
    "slot_policy": "exclusive_npu",
    "selectable_backend": false,
    "uses_ctx_size": true,
    "dynamic_models": false,
    "options": [],
    "support": [
      {
        "backend": "npu",
        "tier": "core",
        "format": "native",
        "supported_os": ["windows"],
        "devices": {
          "amd_npu": ["XDNA2"]
        },
        "device_summary": "XDNA2 NPU",
        "arch_gates": {}
      }
    ],
    "supported_modes": ["chat"],
    "required_checkpoints": ["main"],
    "default_capabilities": [],
    "web_display_name": "Ryzen AI SW NPU",
    "rocm_channels": [],
    "exposes_prometheus_metrics": false,
    "rocm_requires_cwsr_fix": false,
    "version_policy": "exact",
    "self_manages_downloads": false,
    "takes_args": false,
    "arg_variants": [],
    "bin_variants": ["server"],
    "config_extra": {},
    "streams_model_from_storage": false
  },
  "install": {
    "strategy": "github_release",
    "install_recipe": "ryzenai-server",
    "pin_recipe": "ryzenai-llm",
    "supports_split_archive": false,
    "asset_backend": "identity",
    "cases": [
      {
        "repo": "lemonade-sdk/ryzenai-server",
        "filename": "ryzenai-server.zip"
      }
    ]
  },
  "artifacts": {
    "main": {
      "role": "main",
      "strategy": "resolved_path",
      "cache_resolution": "sentinel_directory",
      "import_resolution": "sentinel_directory",
      "absolute_checkpoint_fallback": false,
      "sentinel": "genai_config.json",
      "selection": "first_existing",
      "missing_error": {
        "concat": [
          "Model path does not exist: ",
          {"ref": "/artifacts/main"}
        ]
      }
    }
  },
  "launch": {
    "prepare_order": ["backend", "program", "artifacts", "ports"],
    "backend": {
      "fixed": "npu"
    },
    "program": {
      "source": "managed",
      "install_policy": "always",
      "missing_error": "RyzenAI-Server executable not found even after installation attempt"
    },
    "ports": [
      {
        "name": "http",
        "reject_zero": false,
        "error": ""
      }
    ],
    "argv": [
      {
        "args": [
          "-m",
          {"ref": "/artifacts/main"},
          "--port",
          {"string": {"ref": "/launch/ports/http"}},
          "--ctx-size",
          {"string": {"ref": "/options/ctx_size"}}
        ]
      },
      {
        "when": {
          "eq": [
            {"ref": "/launch/log_level"},
            "debug"
          ]
        },
        "args": ["--verbose"]
      }
    ],
    "environment": {
      "preset": "inherit",
      "set": []
    },
    "working_directory": "inherit",
    "output": {
      "inherit_levels": ["debug"],
      "filter": true
    },
    "readiness": {
      "port": "http",
      "path": "/health",
      "timeout": 600
    },
    "watchdog": {
      "policy": "standard",
      "port": "http",
      "path": "/health"
    }
  },
  "operations": [
    {
      "operation": "chat_completion",
      "delivery": "buffered",
      "model_modes": ["*"],
      "transport": {
        "kind": "http_json",
        "method": "POST",
        "path": "/v1/chat/completions",
        "port": "http",
        "timeout": "global",
        "response_codec": "json.v1"
      },
      "request": {
        "base": "identity",
        "remove": [],
        "set": {},
        "omit_missing": false
      }
    },
    {
      "operation": "completion",
      "delivery": "buffered",
      "model_modes": ["*"],
      "transport": {
        "kind": "http_json",
        "method": "POST",
        "path": "/v1/completions",
        "port": "http",
        "timeout": "global",
        "response_codec": "json.v1"
      },
      "request": {
        "base": "identity",
        "remove": [],
        "set": {},
        "omit_missing": false
      }
    },
    {
      "operation": "responses",
      "delivery": "buffered",
      "model_modes": ["*"],
      "transport": {
        "kind": "http_json",
        "method": "POST",
        "path": "/v1/responses",
        "port": "http",
        "timeout": "global",
        "response_codec": "json.v1"
      },
      "request": {
        "base": "identity",
        "remove": [],
        "set": {},
        "omit_missing": false
      }
    },
    {
      "operation": "chat_completion",
      "delivery": "streaming",
      "model_modes": ["*"],
      "transport": {
        "kind": "http_sse",
        "method": "POST",
        "path": "/v1/chat/completions",
        "port": "http",
        "timeout": "global",
        "stream_codec": "openai_sse.v1"
      },
      "request": {
        "base": "identity",
        "remove": [],
        "set": {},
        "omit_missing": false
      }
    },
    {
      "operation": "completion",
      "delivery": "streaming",
      "model_modes": ["*"],
      "transport": {
        "kind": "http_sse",
        "method": "POST",
        "path": "/v1/completions",
        "port": "http",
        "timeout": "global",
        "stream_codec": "openai_sse.v1"
      },
      "request": {
        "base": "identity",
        "remove": [],
        "set": {},
        "omit_missing": false
      }
    },
    {
      "operation": "responses",
      "delivery": "streaming",
      "model_modes": ["*"],
      "transport": {
        "kind": "http_sse",
        "method": "POST",
        "path": "/v1/responses",
        "port": "http",
        "timeout": "global",
        "stream_codec": "openai_sse.v1"
      },
      "request": {
        "base": "identity",
        "remove": [],
        "set": {},
        "omit_missing": false
      }
    }
  ],
  "hooks": {},
  "rationale": [
    {
      "subject": "/artifacts/main",
      "text": "The first recursive regular-file match wins in filesystem iterator order. Cache resolution falls back to the original cache string; import discovery returns an empty string when no sentinel exists.",
      "source": "bc5f994c29eb256a1f3fca60259ab656782493f8:src/cpp/server/backends/ryzenai/ryzenai_server.cpp:104",
      "tests": ["ryzenai_first_sentinel", "ryzenai_sentinel_fallbacks"]
    },
    {
      "subject": "/launch/prepare_order",
      "text": "Installation and executable lookup precede model-path validation.",
      "source": "bc5f994c29eb256a1f3fca60259ab656782493f8:src/cpp/server/backends/ryzenai/ryzenai_server.cpp:36",
      "tests": ["ryzenai_launch_failure_order"]
    },
    {
      "subject": "/metadata/log_level_policy",
      "text": "Only the exact factory input debug enables verbose child output; trace and all other levels become info.",
      "source": "bc5f994c29eb256a1f3fca60259ab656782493f8:src/cpp/server/backends/ryzenai/ryzenai_server.cpp:95",
      "tests": ["ryzenai_debug_conversion"]
    }
  ]
}
