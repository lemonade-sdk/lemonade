{
  "schema_version": 1,
  "id": "thinksound",
  "recipe": "thinksound",
  "kind": "local",
  "metadata": {
    "display_name": "ThinkSound",
    "server_name": "thinksound-server",
    "log_category": "thinksound-server",
    "log_level_policy": "passthrough",
    "binary": "ts-server",
    "config_section": "",
    "default_device": "gpu",
    "slot_policy": "standard",
    "selectable_backend": true,
    "uses_ctx_size": false,
    "dynamic_models": false,
    "options": [
      {
        "name": "thinksound_backend",
        "cli_flag": "--thinksound",
        "default_value": "",
        "type_name": "BACKEND",
        "value_type": "string",
        "help": "ThinkSound backend to use",
        "group": "Audio Generation Options",
        "unset_values": [null, -1, "", "auto"],
        "ui": {
          "label": "Backend",
          "control": "select",
          "order": 10,
          "choices": "supported_backends"
        }
      }
    ],
    "support": [
      {
        "backend": "cuda",
        "tier": "experimental",
        "format": "native",
        "supported_os": ["linux", "windows"],
        "devices": {
          "nvidia_gpu": []
        },
        "device_summary": "NVIDIA GPUs",
        "arch_gates": {}
      },
      {
        "backend": "vulkan",
        "tier": "experimental",
        "format": "native",
        "supported_os": ["linux", "windows"],
        "devices": {
          "cpu": ["x86_64"],
          "amd_gpu": [],
          "nvidia_gpu": []
        },
        "device_summary": "Vulkan-capable GPUs",
        "arch_gates": {}
      },
      {
        "backend": "rocm",
        "tier": "experimental",
        "format": "native",
        "supported_os": ["linux", "windows"],
        "devices": {
          "amd_gpu": [
            "gfx1150",
            "gfx1151",
            "gfx1152",
            "gfx103X",
            "gfx110X",
            "gfx120X"
          ]
        },
        "device_summary": "Supported AMD ROCm iGPU/dGPU families (ROCm via TheRock)",
        "arch_gates": {}
      }
    ],
    "supported_modes": ["audio-generation"],
    "required_checkpoints": ["main"],
    "default_capabilities": [],
    "web_display_name": "",
    "rocm_channels": ["stable"],
    "exposes_prometheus_metrics": false,
    "rocm_requires_cwsr_fix": false,
    "version_policy": "exact",
    "self_manages_downloads": false,
    "takes_args": false,
    "arg_variants": [],
    "bin_variants": ["vulkan", "rocm", "cuda"],
    "config_extra": {},
    "streams_model_from_storage": false
  },
  "install": {
    "strategy": "github_release",
    "install_recipe": "thinksound",
    "pin_recipe": "thinksound",
    "supports_split_archive": false,
    "asset_backend": "collapse_rocm_prefix",
    "cases": [
      {
        "os": ["windows"],
        "repo": "pwilkin/thinksound.cpp",
        "filename": {
          "concat": [
            "thinksound-",
            {"ref": "/install/asset_backend"},
            "-windows-x64.zip"
          ]
        }
      },
      {
        "os": ["linux", "macos"],
        "repo": "pwilkin/thinksound.cpp",
        "filename": {
          "concat": [
            "thinksound-",
            {"ref": "/install/asset_backend"},
            "-linux-x64.tar.gz"
          ]
        }
      }
    ]
  },
  "artifacts": {
    "main": {
      "role": "main",
      "strategy": "resolved_path",
      "cache_resolution": "active_snapshot",
      "import_resolution": "default",
      "absolute_checkpoint_fallback": false,
      "files": [
        "dit-bf16.gguf",
        "t5-bf16.gguf",
        "metaclip-text-f32.gguf",
        "vae-f32.gguf",
        "t5-tokenizer.gguf",
        "clip-tokenizer.gguf"
      ],
      "missing_error": {
        "concat": [
          "Model path not found for checkpoint: ",
          {"ref": "/model/checkpoint"}
        ]
      }
    }
  },
  "launch": {
    "prepare_order": ["artifacts", "backend", "program", "ports"],
    "backend": {
      "option": "thinksound_backend",
      "fallback": "first_supported",
      "on_empty": {
        "operation": "ThinkSound audio generation",
        "target": "this system: no supported GPU backend (Vulkan, ROCm, or CUDA) detected"
      }
    },
    "program": {
      "source": "external_or_managed",
      "install_policy": "always"
    },
    "ports": [
      {
        "name": "http",
        "reject_zero": true,
        "error": "Failed to find an available port"
      }
    ],
    "argv": [
      {
        "args": [
          "--dir",
          {"ref": "/artifacts/main"},
          "--host",
          "127.0.0.1",
          "--port",
          {"string": {"ref": "/launch/ports/http"}}
        ]
      }
    ],
    "environment": {
      "preset": "bundled_accelerator_runtime",
      "set": []
    },
    "working_directory": "inherit",
    "output": {
      "inherit_levels": ["debug", "trace"],
      "filter": false
    },
    "readiness": {
      "port": "http",
      "path": "/health",
      "timeout": 600
    },
    "watchdog": {
      "policy": "standard",
      "port": "http",
      "path": "/health"
    }
  },
  "operations": [
    {
      "operation": "audio_generation",
      "delivery": "buffered",
      "model_modes": ["audio-generation"],
      "transport": {
        "kind": "http_bytes",
        "method": "POST",
        "path": "/generate",
        "port": "http",
        "timeout": 600,
        "stream_codec": "raw_bytes.v1"
      },
      "formats": ["wav"],
      "format_metadata": {},
      "request": {
        "base": "empty",
        "remove": [],
        "omit_missing": true,
        "set": {
          "/caption": {
            "ref": "/request/prompt",
            "type": "string",
            "default": ""
          },
          "/description": {
            "coalesce": [
              {"ref": "/request/description"},
              {"ref": "/request/cot"},
              {
                "ref": "/request/prompt",
                "type": "string",
                "default": ""
              }
            ]
          },
          "/duration": {"ref": "/request/duration"},
          "/steps": {"ref": "/request/steps"},
          "/cfg": {"ref": "/request/cfg"},
          "/seed": {"ref": "/request/seed"}
        }
      }
    }
  ],
  "hooks": {},
  "rationale": [
    {
      "subject": "/artifacts/main/files",
      "text": "The server loads the bf16 network set by default; downloading the q8 alternatives adds redundant model data.",
      "source": "9df12e68d:src/cpp/server/backends/thinksound/thinksound_server.cpp:156",
      "tests": ["thinksound_optional_files_order"]
    },
    {
      "subject": "/launch/argv/0",
      "text": "The server scans a directory containing the component networks and tokenizers.",
      "source": "9df12e68d:src/cpp/server/backends/thinksound/thinksound_server.cpp:84",
      "tests": ["thinksound_launch_argv"]
    },
    {
      "subject": "/launch/environment",
      "text": "ROCm runtime directories precede the executable directory and inherited loader path; CUDA additions follow the loader override.",
      "source": "9df12e68d:src/cpp/server/backends/thinksound/thinksound_server.cpp:92",
      "tests": ["thinksound_environment_order"]
    }
  ]
}
