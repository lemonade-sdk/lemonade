{
  "schema_version": 2,
  "id": "hrx",
  "recipe": "llamacpp-hrx",
  "extends": {"builtin": "llamacpp", "contract": 1},
  "merge": {
    "metadata": {
      "display_name": "HRX GPU",
      "log_category": "HRX",
      "binary": "llama-server",
      "config_section": "hrx",
      "selectable_backend": false,
      "support": [
        {
          "id": "hrx-linux",
          "backend": "hrx",
          "tier": "experimental",
          "format": "native",
          "supported_os": ["linux"],
          "devices": {"amd_gpu": ["gfx1100", "gfx1151"]},
          "device_summary": "AMD GPUs (gfx1100, gfx1151)",
          "arch_gates": {
            "gfx1100": {"os": ["linux"], "channels": []},
            "gfx1151": {"os": ["linux"], "channels": []}
          }
        }
      ],
      "supported_modes": ["chat"],
      "web_display_name": "",
      "rocm_channels": [],
      "rocm_requires_cwsr_fix": false,
      "arg_variants": [],
      "bin_variants": ["hrx"]
    },
    "artifacts": {
      "main": {"required_when": true}
    },
    "launch": {
      "prepare_order": ["backend", "install", "artifacts", "ports", "program"],
      "requires": {
        "os": ["linux"],
        "machine_arch": ["x86_64"],
        "error": "The HRX backend is available on Linux x86-64 only"
      },
      "custom_args": {
        "option": "args",
        "error_prefix": "Invalid custom HRX llama-server arguments:\n",
        "reserved": ["-dr", "-hf", "-hff", "-hfr", "-mu", "--docker-repo", "--hf-file", "--hf-repo", "--model-url"],
        "defaults": [
          {
            "id": "parallel",
            "args": "--parallel 1",
            "flag": "--parallel",
            "aliases": ["-np"],
            "stage": "launch",
            "respect_merge_args": false
          }
        ],
        "runtime_input": "preserve"
      },
      "working_directory": "inherit",
      "device_assignment": "preserve",
      "load_log_policy": "loading_and_options",
      "direct_stream_policy": "bound_passthrough"
    },
    "rationale": [
      {
        "subject": "/launch/requires",
        "text": "The HRX bundle is Linux x86-64 only; reject other hosts before model work.",
        "source": "410b5b4e:src/cpp/resources/backends/hrx.json",
        "tests": ["hrx_platform_requirement"]
      },
      {
        "subject": "/launch/custom_args/defaults",
        "match": {"id": "parallel"},
        "text": "One slot keeps ctx_size equal to the context a request actually gets.",
        "source": "410b5b4e:src/cpp/resources/backends/hrx.json",
        "tests": ["hrx_parallel_default"]
      },
      {
        "subject": "/operations",
        "text": "HRX keeps llama-server protocol bindings while advertising only local-GGUF chat startup.",
        "source": "410b5b4e:src/cpp/resources/backends/hrx.json",
        "tests": ["hrx_operation_matrix"]
      },
      {
        "subject": "/launch",
        "text": "Preserve the router device, the two load diagnostics and bound stream passthrough; runtime options have no vanilla defaults.",
        "source": "85788f787:src/cpp/resources/backends/hrx.json",
        "tests": ["hrx_device_preserved", "hrx_load_logs", "hrx_bound_streams", "hrx_runtime_noop"]
      }
    ]
  },
  "edits": [
    {"op": "remove", "path": "/metadata/options", "match": {"id": "backend"}},
    {"op": "remove", "path": "/metadata/options", "match": {"id": "device"}},
    {"op": "merge", "path": "/metadata/options", "match": {"id": "args"}, "value": {"name": "hrx_args", "cli_flag": "--hrx-args", "help": "Custom arguments to pass to the HRX llama-server", "group": "HRX Options"}},
    {"op": "clear", "path": "/metadata/config_extra"},
    {"op": "replace", "path": "/install", "value": {
      "strategy": "github_release", "install_recipe": "llamacpp-hrx", "pin_recipe": "llamacpp-hrx",
      "supports_split_archive": false, "asset_backend": "identity", "repository_result": "full_params",
      "cases": [
        {"id": "hrx-linux", "backend": ["hrx"], "os": ["linux"], "machine_arch": ["x86_64"], "repo": "ROCm/ggml-staging-automation", "filename": {"concat": ["llama-", {"ref": "/install/version"}, "-bin-manylinux-hrx-x64.tar.gz"]}}
      ],
      "errors": {
        "backend": {"concat": ["Unsupported HRX backend '", {"ref": "/install/backend"}, "'; expected 'hrx'"]},
        "os": "The HRX backend is available on Linux x86-64 only",
        "machine_arch": "The HRX backend is available on Linux x86-64 only"
      }
    }},
    {"op": "remove", "path": "/artifacts/mmproj"},
    {"op": "remove", "path": "/artifacts/draft"},
    {"op": "clear", "path": "/hooks"},
    {"op": "remove", "path": "/launch/context_floor"},
    {"op": "replace", "path": "/launch/backend", "value": {"fixed": "hrx"}},
    {"op": "remove", "path": "/launch/argv", "match": {"id": "model-hf"}},
    {"op": "remove", "path": "/launch/argv", "match": {"id": "model-local"}, "at": "/when"},
    {"op": "replace", "path": "/launch/argv", "match": {"id": "ctx"}, "at": "/value", "value": {"string": {"ref": "/options/ctx_size"}}},
    {"op": "merge", "path": "/launch/argv", "match": {"id": "device"}, "value": {"when": true, "value": "HRX0"}},
    {"op": "remove", "path": "/launch/argv", "match": {"id": "debug"}},
    {"op": "remove", "path": "/launch/argv", "match": {"id": "vision"}},
    {"op": "remove", "path": "/launch/argv", "match": {"id": "vision-cpu"}},
    {"op": "remove", "path": "/launch/argv", "match": {"id": "draft"}},
    {"op": "remove", "path": "/launch/argv", "match": {"id": "embedding"}},
    {"op": "remove", "path": "/launch/argv", "match": {"id": "reranking"}},
    {"op": "replace", "path": "/launch/environment", "value": {"preset": "inherit", "set": []}},
    {"op": "add", "path": "/launch/environment/set", "value": {"name": "GGML_DISABLE_VULKAN", "value": "1"}}
  ]
}
