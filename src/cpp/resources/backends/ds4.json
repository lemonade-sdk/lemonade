{
  "schema_version": 1,
  "id": "ds4",
  "recipe": "ds4",
  "kind": "local",
  "metadata": {
    "display_name": "DwarfStar4",
    "server_name": "ds4-server",
    "log_category": "DS4",
    "log_level_policy": "passthrough",
    "binary": "ds4-server",
    "config_section": "",
    "default_device": "gpu",
    "slot_policy": "standard",
    "selectable_backend": false,
    "uses_ctx_size": true,
    "dynamic_models": false,
    "options": [
      {
        "name": "ds4_args",
        "cli_flag": "--ds4-args",
        "default_value": "",
        "type_name": "ARGS",
        "value_type": "string",
        "help": "Custom arguments to pass to ds4-server",
        "group": "DS4 Options",
        "unset_values": [null, -1, "", "auto"]
      }
    ],
    "support": [
      {
        "backend": "rocm",
        "tier": "guest",
        "format": "native",
        "supported_os": ["linux"],
        "devices": {
          "amd_gpu": ["gfx1151"]
        },
        "device_summary": "Prebuilt ds4 for AMD Strix Halo",
        "arch_gates": {}
      }
    ],
    "supported_modes": ["chat"],
    "required_checkpoints": ["main"],
    "default_capabilities": [],
    "web_display_name": "",
    "rocm_channels": [],
    "exposes_prometheus_metrics": false,
    "rocm_requires_cwsr_fix": true,
    "version_policy": "exact",
    "self_manages_downloads": false,
    "takes_args": true,
    "arg_variants": [],
    "bin_variants": [],
    "config_extra": {},
    "streams_model_from_storage": true
  },
  "install": {
    "strategy": "github_release",
    "install_recipe": "ds4",
    "pin_recipe": "ds4",
    "supports_split_archive": false,
    "asset_backend": "identity",
    "cases": [
      {
        "backend": ["rocm"],
        "os": ["linux"],
        "arch": ["gfx1151"],
        "repo": "lemonade-sdk/ds4-rocm",
        "filename": {
          "concat": [
            "ds4-",
            {"ref": "/install/version"},
            "-linux-rocm-",
            {"ref": "/platform/rocm_arch"},
            "-x64.tar.gz"
          ]
        }
      }
    ],
    "errors": {
      "backend": {
        "concat": [
          "ds4 backend '",
          {"ref": "/install/backend"},
          "' is not supported. Supported: rocm"
        ]
      },
      "os": {
        "concat": [
          "ds4 backend 'rocm' publishes no build for ",
          {"ref": "/platform/os"},
          "; Linux only"
        ]
      },
      "missing_arch": "ds4 backend 'rocm' requires a ROCm GPU, but no ROCm architecture was detected",
      "arch": {
        "concat": [
          "ds4 backend 'rocm' publishes no build for ",
          {"ref": "/platform/rocm_arch"},
          "; only gfx1151 is validated upstream"
        ]
      }
    }
  },
  "artifacts": {
    "main": {
      "role": "main",
      "strategy": "resolved_path",
      "cache_resolution": "default",
      "import_resolution": "default",
      "absolute_checkpoint_fallback": true,
      "missing_error": {
        "concat": [
          "ds4: no local GGUF found for model '",
          {"ref": "/model/name"},
          "' (checkpoint: ",
          {"ref": "/model/checkpoint"},
          ")"
        ]
      }
    }
  },
  "launch": {
    "prepare_order": ["artifacts", "backend", "program", "ports"],
    "backend": {
      "fixed": "rocm"
    },
    "program": {
      "source": "managed",
      "install_policy": "always"
    },
    "ports": [
      {
        "name": "http",
        "reject_zero": false,
        "error": ""
      }
    ],
    "argv": [
      {
        "args": [
          "-m",
          {"ref": "/artifacts/main"},
          "--host",
          "127.0.0.1",
          "--port",
          {"string": {"ref": "/launch/ports/http"}}
        ]
      },
      {
        "when": {
          "gt": [
            {"ref": "/options/ctx_size"},
            0
          ]
        },
        "args": [
          "-c",
          {"string": {"ref": "/options/ctx_size"}}
        ]
      },
      {
        "args": ["--ssd-streaming"]
      }
    ],
    "custom_args": {
      "option": "ds4_args",
      "reserved": [
        "-m",
        "--model",
        "--host",
        "--port",
        "-c",
        "--ctx",
        "--backend",
        "--cpu",
        "--metal",
        "--rocm",
        "--cuda"
      ],
      "error_prefix": "Invalid custom ds4-server arguments:\n"
    },
    "environment": {
      "preset": "executable_loader_path",
      "set": []
    },
    "working_directory": "inherit",
    "output": {
      "inherit_levels": ["info", "debug"],
      "filter": true
    },
    "readiness": {
      "port": "http",
      "path": "/v1/models",
      "timeout": "global"
    },
    "watchdog": {
      "policy": "standard",
      "port": "http",
      "path": "/v1/models"
    }
  },
  "operations": [
    {
      "operation": "chat_completion",
      "delivery": "buffered",
      "model_modes": ["*"],
      "transport": {
        "kind": "http_json",
        "method": "POST",
        "path": "/v1/chat/completions",
        "port": "http",
        "timeout": "global",
        "response_codec": "json.v1"
      },
      "request": {
        "base": "identity",
        "remove": [],
        "set": {},
        "omit_missing": false
      }
    },
    {
      "operation": "completion",
      "delivery": "buffered",
      "model_modes": ["*"],
      "transport": {
        "kind": "http_json",
        "method": "POST",
        "path": "/v1/completions",
        "port": "http",
        "timeout": "global",
        "response_codec": "json.v1"
      },
      "request": {
        "base": "identity",
        "remove": [],
        "set": {},
        "omit_missing": false
      }
    },
    {
      "operation": "responses",
      "delivery": "buffered",
      "model_modes": ["*"],
      "transport": {
        "kind": "http_json",
        "method": "POST",
        "path": "/v1/responses",
        "port": "http",
        "timeout": "global",
        "response_codec": "json.v1"
      },
      "request": {
        "base": "identity",
        "remove": [],
        "set": {},
        "omit_missing": false
      }
    },
    {
      "operation": "chat_completion",
      "delivery": "streaming",
      "model_modes": ["*"],
      "transport": {
        "kind": "http_sse",
        "method": "POST",
        "path": "/v1/chat/completions",
        "port": "http",
        "timeout": "global",
        "stream_codec": "openai_sse.v1"
      },
      "request": {
        "base": "identity",
        "remove": [],
        "set": {},
        "omit_missing": false
      }
    },
    {
      "operation": "completion",
      "delivery": "streaming",
      "model_modes": ["*"],
      "transport": {
        "kind": "http_sse",
        "method": "POST",
        "path": "/v1/completions",
        "port": "http",
        "timeout": "global",
        "stream_codec": "openai_sse.v1"
      },
      "request": {
        "base": "identity",
        "remove": [],
        "set": {},
        "omit_missing": false
      }
    },
    {
      "operation": "responses",
      "delivery": "streaming",
      "model_modes": ["*"],
      "transport": {
        "kind": "http_sse",
        "method": "POST",
        "path": "/v1/responses",
        "port": "http",
        "timeout": "global",
        "stream_codec": "openai_sse.v1"
      },
      "request": {
        "base": "identity",
        "remove": [],
        "set": {},
        "omit_missing": false
      }
    }
  ],
  "hooks": {},
  "rationale": [
    {
      "subject": "/launch/argv/2",
      "text": "The supported model exceeds the validated device's practical full-residency arena; the existing wrapper enables SSD streaming before user arguments.",
      "source": "bc5f994c29eb256a1f3fca60259ab656782493f8:src/cpp/server/backends/ds4/ds4_server.cpp:107",
      "tests": ["ds4_ssd_streaming_precedes_custom_args"]
    },
    {
      "subject": "/launch/readiness",
      "text": "The backend has no health endpoint; its models endpoint is used for readiness and subsequently for watchdog probes.",
      "source": "bc5f994c29eb256a1f3fca60259ab656782493f8:src/cpp/server/backends/ds4/ds4_server.cpp:147",
      "tests": ["ds4_models_readiness_and_watchdog"]
    },
    {
      "subject": "/launch/environment",
      "text": "The bundled runtime is adjacent to the executable; the built-in compatibility attachment preserves the wrapper's literal LD_LIBRARY_PATH behavior on every fixture host.",
      "source": "bc5f994c29eb256a1f3fca60259ab656782493f8:src/cpp/server/backends/ds4/ds4_server.cpp:127",
      "tests": ["ds4_loader_environment"]
    },
    {
      "subject": "/launch/custom_args/reserved",
      "text": "ds4-server parses its arguments left to right, so a later flag wins over the ones Lemonade sets: moving the port breaks readiness and proxying, rebinding the host exposes the backend, swapping the model desynchronises the router, and the backend-selection flags would run the child on a different device than the one Lemonade is tracking.",
      "source": "be8f4c26485ef5d1131329cb14ade7d0ae3f6e76:src/cpp/include/lemon/backends/ds4/ds4.h:12",
      "tests": ["ds4_reserved_custom_args_rejected"]
    },
    {
      "subject": "/install/cases/0/os",
      "text": "The direct backend-install endpoint does not go through model filtering, and the support row's architecture check does not read supported_os, so the install case itself must refuse other operating systems rather than resolve the Linux asset.",
      "source": "be8f4c26485ef5d1131329cb14ade7d0ae3f6e76:src/cpp/include/lemon/backends/ds4/ds4.h:17",
      "tests": ["ds4_install_refuses_other_os"]
    }
  ]
}
