{
  "schema_version": 1,
  "id": "onnxruntime",
  "recipe": "onnxruntime",
  "kind": "local",
  "metadata": {
    "display_name": "ONNX Runtime",
    "server_name": "ort-server",
    "log_category": "OnnxRuntimeServer",
    "log_level_policy": "passthrough",
    "binary": "ort-server",
    "config_section": "",
    "default_device": "cpu",
    "slot_policy": "standard",
    "selectable_backend": false,
    "uses_ctx_size": false,
    "dynamic_models": false,
    "options": [
      {
        "name": "onnxruntime_args",
        "cli_flag": "--onnxruntime-args",
        "default_value": "",
        "type_name": "ARGS",
        "value_type": "string",
        "help": "Custom arguments to pass to ort-server",
        "group": "ONNX Runtime Options",
        "unset_values": [null, -1, "", "auto"]
      }
    ],
    "support": [
      {
        "backend": "cpu",
        "tier": "experimental",
        "format": "native",
        "supported_os": ["windows"],
        "devices": {"cpu": ["x86_64"]},
        "device_summary": "x86_64 CPU",
        "arch_gates": {}
      },
      {
        "backend": "cpu",
        "tier": "experimental",
        "format": "native",
        "supported_os": ["linux"],
        "devices": {"cpu": ["x86_64", "arm64"]},
        "device_summary": "x86_64/arm64 CPU",
        "arch_gates": {}
      },
      {
        "backend": "cpu",
        "tier": "experimental",
        "format": "native",
        "supported_os": ["macos"],
        "devices": {"cpu": ["arm64"]},
        "device_summary": "arm64 CPU",
        "arch_gates": {}
      }
    ],
    "supported_modes": ["classification"],
    "required_checkpoints": ["main"],
    "default_capabilities": [],
    "web_display_name": "",
    "rocm_channels": [],
    "exposes_prometheus_metrics": false,
    "rocm_requires_cwsr_fix": false,
    "version_policy": "exact",
    "self_manages_downloads": false,
    "takes_args": true,
    "arg_variants": ["cpu"],
    "bin_variants": ["cpu"],
    "config_extra": {},
    "streams_model_from_storage": false
  },
  "install": {
    "strategy": "github_release",
    "install_recipe": "onnxruntime",
    "pin_recipe": "onnxruntime",
    "supports_split_archive": false,
    "asset_backend": "identity",
    "cases": [
      {
        "os": ["windows"],
        "machine_arch": ["x86_64", ""],
        "repo": "lemonade-sdk/ort-server",
        "filename": {"concat": ["ort-server-", {"ref": "/install/version"}, "-windows-x64.zip"]}
      },
      {
        "os": ["macos"],
        "repo": "lemonade-sdk/ort-server",
        "filename": {"concat": ["ort-server-", {"ref": "/install/version"}, "-macos-arm64.tar.gz"]}
      },
      {
        "os": ["linux"],
        "machine_arch": ["aarch64"],
        "repo": "lemonade-sdk/ort-server",
        "filename": {"concat": ["ort-server-", {"ref": "/install/version"}, "-linux-arm64.tar.gz"]}
      },
      {
        "os": ["linux"],
        "machine_arch": ["x86_64", ""],
        "repo": "lemonade-sdk/ort-server",
        "filename": {"concat": ["ort-server-", {"ref": "/install/version"}, "-linux-x64.tar.gz"]}
      }
    ],
    "errors": {
      "machine_arch": "The onnxruntime backend has no Windows-on-ARM64 build of ort-server yet"
    }
  },
  "artifacts": {
    "main": {
      "role": "main",
      "strategy": "hook",
      "hook": {"id": "onnxruntime.model_directory", "params": {}},
      "missing_error": {
        "concat": ["Model directory not found for checkpoint: ", {"ref": "/model/checkpoint"}]
      }
    }
  },
  "launch": {
    "prepare_order": ["backend", "install", "artifacts", "hook", "program", "ports"],
    "backend": {"fixed": "cpu"},
    "program": {"source": "managed", "install_policy": "always"},
    "ports": [
      {
        "name": "http",
        "strategy": "probe",
        "reject_zero": true,
        "error": "Failed to find an available port for ort-server"
      }
    ],
    "argv": [
      {
        "args": [
          "--model-path",
          {"ref": "/launch/hook"},
          "--port",
          {"string": {"ref": "/launch/ports/http"}}
        ]
      }
    ],
    "custom_args": {
      "option": "onnxruntime_args",
      "reserved": ["--model-path", "--port"],
      "error_prefix": "Invalid custom ort-server arguments:\n"
    },
    "environment": {"preset": "inherit", "set": []},
    "working_directory": "inherit",
    "output": {
      "inherit_levels": ["info", "debug", "trace"],
      "filter": false
    },
    "readiness": {"port": "http", "path": "/health", "timeout": 600},
    "watchdog": {"policy": "standard", "port": "http", "path": "/health"}
  },
  "operations": [
    {
      "operation": "classification",
      "delivery": "buffered",
      "model_modes": ["*"],
      "handler": {"id": "onnxruntime.classify", "params": {}},
      "request": {"base": "identity"}
    }
  ],
  "hooks": {
    "launch": {"id": "onnxruntime.servable_directory", "params": {}},
    "start_failure": {"id": "onnxruntime.startup_error", "params": {}}
  },
  "rationale": [
    {
      "subject": "/artifacts/main/hook",
      "text": "A servable model is a directory with model.onnx, tokenizer.json and config.json; config.json is required even with a manifest because the manifest describes only the output contract. In a Hugging Face cache refs/main names the active revision, so an older snapshot beside it is not an ambiguity; only a local import is searched whole. Resolution runs during bulk model listing and never throws.",
      "source": "7fb46ce0e:src/cpp/server/backends/onnxruntime/onnxruntime_server.cpp:264",
      "tests": ["onnxruntime_resolution"]
    },
    {
      "subject": "/hooks/launch",
      "text": "Resolution falls back to the cache root when the layout is ambiguous, so the load is the sole arbiter and rejects a complete root that also contains a nested model.",
      "source": "7fb46ce0e:src/cpp/server/backends/onnxruntime/onnxruntime_server.cpp:158",
      "tests": ["onnxruntime_servable_directory"]
    },
    {
      "subject": "/hooks/start_failure",
      "text": "ort-server refuses a model by printing one line and exiting, which is invisible when lemond runs windowless. A rerun of at most 20 seconds captures up to 400 bytes of output, or reports the exit code and the files installed beside the binary (0xC0000135 marks a DLL missing on Windows).",
      "source": "7fb46ce0e:src/cpp/server/backends/onnxruntime/onnxruntime_server.cpp:40",
      "tests": ["onnxruntime_startup_error"]
    },
    {
      "subject": "/launch/ports/0",
      "text": "ort-server takes the first free port from 8001 without the server's port chooser.",
      "source": "7fb46ce0e:src/cpp/server/backends/onnxruntime/onnxruntime_server.cpp:185",
      "tests": ["onnxruntime_port"]
    }
  ]
}
