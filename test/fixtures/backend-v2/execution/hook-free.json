{
  "schema_version": 2,
  "id": "compiler-fixture",
  "recipe": "compiler-fixture",
  "merge": {
    "kind": "local",
    "metadata": {
      "display_name": "Synthetic export",
      "server_name": "fake-engine",
      "binary": "fake-engine",
      "supported_modes": [
        "chat"
      ],
      "support": []
    },
    "install": {
      "strategy": "none"
    },
    "artifacts": {},
    "launch": {
      "prepare_order": [
        "backend",
        "artifacts",
        "program",
        "ports"
      ],
      "backend": {
        "fixed": "cpu"
      },
      "program": {
        "source": "managed",
        "install_policy": "always"
      },
      "ports": [
        {
          "name": "http",
          "reject_zero": false,
          "error": ""
        }
      ],
      "argv": [],
      "environment": {
        "preset": "inherit"
      },
      "working_directory": {
        "windows": "executable_directory",
        "linux": "inherit",
        "macos": "inherit"
      },
      "output": {
        "inherit_levels": [
          "info",
          "debug",
          "trace"
        ],
        "filter": true
      },
      "readiness": {
        "port": "http",
        "path": "/health",
        "timeout": 600
      },
      "watchdog": {
        "policy": "standard",
        "port": "http",
        "path": "/health"
      }
    },
    "operations": [
      {
        "id": "chat.buffered",
        "operation": "chat_completion",
        "delivery": "buffered",
        "model_modes": [
          "chat"
        ],
        "transport": {
          "kind": "http_json",
          "method": "POST",
          "path": "/chat",
          "port": "http",
          "timeout": 1
        },
        "request": {
          "base": "identity"
        }
      }
    ]
  }
}
