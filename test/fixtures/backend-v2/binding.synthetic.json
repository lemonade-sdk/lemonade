      "environment": {
        "id": "llamacpp.environment.v1",
        "params": {}
      },
      "system": {
        "id": "llamacpp.system.v1",
        "params": {}
      }
    },
    "artifacts": {
      "main": {
        "role": "main",
        "strategy": "hook",
        "missing_error": "missing model",
        "hook": {
          "id": "llamacpp.artifacts.v1",
          "params": {}
        }
      }
    }
  }
