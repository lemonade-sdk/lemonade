    ],
    "hooks": {
      "backend": {
        "id": "llamacpp.backend.v1",
        "params": {}
      },
      "install_context": {
        "id": "llamacpp.install_context.v1",
        "params": {}
      },
      "runtime_options": {
        "id": "llamacpp.runtime_options.v1",
        "params": {}
      },
      "launch": {
        "id": "llamacpp.prepare.v1",
        "params": {}
