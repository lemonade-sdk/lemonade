  "definition": {
    "schema_version": 2,
    "id": "gufo",
    "recipe": "gufo",
    "merge": {
      "kind": "container",
      "metadata": {
        "display_name": "Gufo",
        "server_name": "gufo",
        "binary": "gufo",
        "support": [
          {
            "id": "halobox",
            "backend": "halobox",
            "tier": "experimental",
            "format": "container",
            "supported_os": [
              "linux"
            ],
            "devices": {
              "gpu": [
                "gfx1151"
              ]
            },
            "device_summary": "Strix Halo"
          },
          {
            "id": "nathanw",
            "backend": "nathanw",
            "tier": "experimental",
            "format": "container",
            "supported_os": [
              "linux"
            ],
            "devices": {
              "gpu": [
                "gfx1151"
              ]
            },
            "device_summary": "Strix Halo"
          }
        ],
        "supported_modes": [
          "chat"
        ],
        "options": [
          {
            "id": "engine",
            "name": "fixture_engine",
            "value_type": "string",
            "default_value": "halobox"
          },
          {
            "id": "device",
            "name": "fixture_device",
            "value_type": "string",
            "default_value": ""
          }
        ]
      },
      "containers": {
        "halobox": {
          "repository": "ghcr.io/peonist-ai/gufo",
          "pin": {
            "source": "backend_versions",
            "recipe": "gufo",
            "backend": "halobox"
          },
          "devices": [
            "/dev/dri",
            "/dev/kfd"
          ],
          "cap_add": [],
          "policy": "lemonade-isolated-v1",
          "network": "private_internal",
          "teardown": "stop_remove_reap",
          "stop_grace_seconds": 10
        },
        "nathanw": {
          "repository": "ghcr.io/peonist-ai/gufo",
          "pin": {
            "source": "backend_versions",
            "recipe": "gufo",
            "backend": "nathanw"
          },
          "devices": [
            "/dev/dri"
          ],
          "cap_add": [],
          "policy": "lemonade-isolated-v1",
          "network": "private_internal",
          "teardown": "stop_remove_reap",
          "stop_grace_seconds": 10
        }
      },
      "install": {
        "strategy": "oci"
      },
      "artifacts": {
        "main": {
          "role": "main",
          "strategy": "resolved_path",
          "missing_error": "GGUF checkpoint is required"
        }
      },
      "launch": {
        "prepare_order": [
          "backend",
          "artifacts",
          "program",
          "ports"
        ],
        "backend": {
          "option": "engine",
          "fallback": "first_supported",
          "on_empty": {
            "operation": "fixture",
            "target": "container"
          }
        },
        "execution": {
          "cases": [
            {
              "id": "halobox",
              "backends": [
                "halobox"
              ],
              "kind": "container",
              "container": "halobox",
              "program": {
                "source": "image_command",
                "name": "halobox-fixture"
              },
              "device_validation": {
                "backend": "rocm"
              }
            },
            {
              "id": "nathanw",
              "backends": [
                "nathanw"
              ],
              "kind": "container",
              "container": "nathanw",
              "program": {
                "source": "image_command",
                "name": "nathanw-fixture"
              },
              "device_validation": {
                "backend": "vulkan"
              }
            }
          ]
        },
        "mounts": [
          {
            "id": "main",
            "artifact": "main",
            "expand": "gguf_shards",
            "destination": "/mnt/models"
          }
        ],
        "address": {
          "source": "process_start"
        },
        "ports": [
          {
            "name": "http",
            "reject_zero": true,
            "error": "No HTTP port available"
          }
        ],
        "argv": [
          {
            "id": "serve",
            "args": [
              "serve",
              "llm"
            ]
          },
          {
            "id": "model",
            "flag": "--model",
            "value": {
              "ref": "/artifacts/main"
            }
          },
          {
            "id": "name",
            "flag": "--served-model-name",
            "value": {
              "ref": "/model/name"
            }
          },
          {
            "id": "host",
            "flag": "--host",
            "value": "0.0.0.0"
          },
          {
            "id": "port",
            "flag": "--port",
            "value": {
              "string": {
                "ref": "/launch/ports/http"
              }
            }
          }
        ],
        "environment": {
          "preset": "inherit"
        },
        "working_directory": "inherit",
        "output": {
          "inherit_levels": [
            "info",
            "debug",
            "trace"
          ],
          "filter": false
        },
        "readiness": {
          "port": "http",
          "path": "/ready",
          "timeout": "global"
        },
        "watchdog": {
          "policy": "standard",
          "port": "http",
          "path": "/ready"
        }
      },
      "operations": [
        {
          "id": "chat.buffered",
          "operation": "chat_completion",
          "delivery": "buffered",
          "model_modes": [
            "chat"
          ],
          "transport": {
            "kind": "http_json",
            "method": "POST",
            "path": "/v1/chat/completions",
            "port": "http",
            "timeout": "global"
          },
          "request": {
            "base": "identity"
          }
        },
        {
          "id": "chat.streaming",
          "operation": "chat_completion",
          "delivery": "streaming",
          "model_modes": [
            "chat"
          ],
          "transport": {
            "kind": "http_sse",
            "method": "POST",
            "path": "/v1/chat/completions",
            "port": "http",
            "timeout": "global"
          },
          "request": {
            "base": "identity"
          }
        }
      ],
      "hooks": {
        "backend": {
          "id": "llamacpp.backend.v1",
          "params": {}
        }
      }
    }
  },
