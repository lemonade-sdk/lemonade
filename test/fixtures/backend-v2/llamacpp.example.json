{
  "schema_version": 2,
  "id": "llamacpp",
  "recipe": "llamacpp",
  "merge": {
    "kind": "local",
    "metadata": {
      "display_name": "Llama.cpp GPU",
      "server_name": "llama-server",
      "log_category": "LlamaCpp",
      "log_level_policy": "passthrough",
      "binary": {
        "windows": "llama-server.exe",
        "linux": "llama-server",
        "macos": "llama-server"
      },
      "config_section": "",
      "default_device": "gpu",
      "slot_policy": "standard",
      "selectable_backend": true,
      "uses_ctx_size": true,
      "dynamic_models": false,
      "options": [
        {
          "id": "backend",
          "name": "llamacpp_backend",
          "cli_flag": "--llamacpp",
          "default_value": "",
          "type_name": "BACKEND",
          "value_type": "string",
          "help": "LlamaCpp backend to use",
          "group": "Llama.cpp Backend Options",
          "unset_values": [null, -1, "", "auto"]
        },
        {
          "id": "device",
          "name": "llamacpp_device",
          "cli_flag": "--llamacpp-device",
          "default_value": "",
          "type_name": "DEVICES",
          "value_type": "string",
          "help": "Comma-separated list of accelerator devices to use (e.g. Vulkan0)",
          "group": "Llama.cpp Backend Options",
          "unset_values": [null, -1, "", "auto"]
        },
        {
          "id": "args",
          "name": "llamacpp_args",
          "cli_flag": "--llamacpp-args",
          "default_value": "",
          "type_name": "ARGS",
          "value_type": "string",
          "help": "Custom arguments to pass to llama-server",
          "group": "Llama.cpp Backend Options",
          "unset_values": [null, -1, "", "auto"]
        }
      ],
      "support": [
        {
          "id": "cpu",
          "backend": "cpu",
          "tier": "core",
          "format": "native",
          "supported_os": ["windows", "linux"],
          "devices": {"cpu": ["x86_64", "arm64"]},
          "device_summary": "x86_64 CPU; ARM64 CPU (Linux)"
        }
      ],
      "supported_modes": ["chat", "embeddings", "reranking"],
      "required_checkpoints": ["main"],
      "default_capabilities": [],
      "web_display_name": "llama.cpp GPU",
      "rocm_channels": ["stable", "nightly"],
      "exposes_prometheus_metrics": true,
      "rocm_requires_cwsr_fix": true,
      "version_policy": "exact",
      "self_manages_downloads": false,
      "takes_args": true,
      "arg_variants": ["rocm", "vulkan", "cpu"],
      "bin_variants": ["rocm", "vulkan", "cuda", "cpu"],
      "config_extra": {"prefer_system": true},
      "streams_model_from_storage": false
    },
    "install": {
      "strategy": "github_release",
      "install_recipe": "llamacpp",
      "pin_recipe": "llamacpp",
      "supports_split_archive": false,
      "asset_backend": "identity",
      "cases": [
        {
          "id": "cpu-linux-x64",
          "backend": ["cpu"],
          "os": ["linux"],
          "machine_arch": ["x86_64"],
          "repo": "ggml-org/llama.cpp",
          "filename": {
            "concat": [
              "llama-",
              {"ref": "/install/version"},
              "-bin-ubuntu-x64.tar.gz"
            ]
          }
        }
      ]
    },
    "artifacts": {
      "main": {
        "role": "main",
        "strategy": "hook",
        "hook": {"id": "llamacpp.gguf", "params": {}},
        "check": "nonempty",
        "required_when": {"not": {"ref": "/launch/hook/hf_load"}},
        "missing_error": {
          "concat": [
            "GGUF file not found for checkpoint: ",
            {"ref": "/model/checkpoint"}
          ]
        }
      },
      "mmproj": {
        "role": "mmproj",
        "strategy": "resolved_path",
        "check": "nonempty",
        "required_when": false,
        "missing_error": "Optional mmproj path is unavailable"
      },
      "draft": {
        "role": "draft",
        "strategy": "resolved_path",
        "check": "nonempty",
        "required_when": false,
        "missing_error": "Optional draft path is unavailable"
      }
    },
    "launch": {
      "prepare_order": ["backend", "install", "hook", "artifacts", "ports", "program"],
      "backend": {
        "option": "backend",
        "fallback": "first_supported",
        "on_empty": {
          "operation": "llama.cpp inference",
          "target": "this system"
        }
      },
      "program": {"source": "managed", "install_policy": "always"},
      "ports": [
        {"name": "http", "reject_zero": false, "error": ""}
      ],
      "context_floor": {"embedding": 8192},
      "argv": [
        {
          "id": "model-hf",
          "flag": "-hf",
          "value": {"ref": "/model/checkpoint"},
          "when": {"ref": "/launch/hook/hf_load"},
          "aliases": ["--hf-repo", "-mr", "--hf-file", "-mf"],
          "reserve": "when_active"
        },
        {
          "id": "model-local",
          "flag": "-m",
          "value": {"ref": "/artifacts/main"},
          "when": {"not": {"ref": "/launch/hook/hf_load"}},
          "aliases": ["--model"],
          "reserve": "when_active"
        },
        {
          "id": "ctx",
          "flag": "--ctx-size",
          "value": {"string": {"ref": "/launch/hook/context_size"}},
          "aliases": ["-c"]
        },
        {
          "id": "device",
          "flag": "--device",
          "value": {"option": "device", "type": "string"},
          "when": {"not": {"eq": [{"option": "device"}, ""]}},
          "aliases": ["-dev"],
          "reserve": "always"
        },
        {
          "id": "port",
          "flag": "--port",
          "value": {"string": {"ref": "/launch/ports/http"}}
        },
        {
          "id": "jinja",
          "flag": "--jinja",
          "aliases": ["--no-jinja"]
        },
        {"id": "metrics", "flag": "--metrics"},
        {
          "id": "debug",
          "args": ["-lv", "4"],
          "when": {
            "any": [
              {"eq": [{"ref": "/launch/log_level"}, "debug"]},
              {"eq": [{"ref": "/launch/log_level"}, "trace"]}
            ]
          }
        },
        {
          "id": "vision",
          "flag": "--mmproj",
          "value": {"ref": "/artifacts/mmproj"},
          "when": {"ref": "/launch/hook/use_mmproj"},
          "aliases": [
            "-mm", "-mmu", "--mmproj-url",
            "--no-mmproj", "--mmproj-auto", "--no-mmproj-auto"
          ],
          "reserve": "always"
        },
        {
          "id": "vision-cpu",
          "flag": "--no-mmproj-offload",
          "when": {"ref": "/launch/hook/mmproj_on_cpu"},
          "reserve": "when_active"
        },
        {
          "id": "draft",
          "flag": "--model-draft",
          "value": {"ref": "/artifacts/draft"},
          "when": {"ref": "/launch/hook/use_draft_checkpoint"},
          "aliases": ["-md", "--spec-draft-model"],
          "reserve": "always"
        },
        {
          "id": "embedding",
          "flag": "--embeddings",
          "when": {"ref": "/launch/hook/embedding"},
          "aliases": ["--embedding"],
          "reserve": "always"
        },
        {
          "id": "reranking",
          "flag": "--reranking",
          "when": {"ref": "/launch/hook/reranking"},
          "aliases": ["--rerank"],
          "reserve": "always"
        }
      ],
      "custom_args": {
        "option": "args",
        "reserved": [],
        "error_prefix": "Invalid custom llama-server arguments:\n",
        "defaults": [
          {
            "id": "parallel",
            "args": "--parallel 1",
            "flag": "--parallel",
            "aliases": ["-np"],
            "stage": "runtime_options",
            "respect_merge_args": true
          }
        ]
      },
      "environment": {"preset": "hook", "set": []},
      "working_directory": {
        "windows": "executable_directory",
        "linux": "inherit",
        "macos": "inherit"
      },
      "output": {
        "inherit_levels": ["info", "debug", "trace"],
        "filter": true
      },
      "readiness": {"port": "http", "path": "/health", "timeout": 600},
      "watchdog": {"policy": "standard", "port": "http", "path": "/health"}
    },
    "operations": [
      {
        "id": "chat.buffered",
        "operation": "chat_completion",
        "delivery": "buffered",
        "model_modes": ["*"],
        "transport": {"kind": "http_json", "method": "POST", "path": "/v1/chat/completions", "port": "http", "timeout": "global", "response_codec": "json.v1"},
        "request": {"base": "identity", "hooks": [
          {"id": "llamacpp.max_tokens_alias", "params": {}},
          {"id": "llamacpp.tool_schema_limits", "params": {}}
        ]},
        "response": {"hooks": [{"id": "llamacpp.client_model", "params": {}}]}
      },
      {
        "id": "completion.buffered",
        "operation": "completion",
        "delivery": "buffered",
        "model_modes": ["*"],
        "transport": {"kind": "http_json", "method": "POST", "path": "/v1/completions", "port": "http", "timeout": "global", "response_codec": "json.v1"},
        "request": {"base": "identity", "hooks": [{"id": "llamacpp.max_tokens_alias", "params": {}}]},
        "response": {"hooks": [{"id": "llamacpp.client_model", "params": {}}]}
      },
      {
        "id": "responses.buffered",
        "operation": "responses",
        "delivery": "buffered",
        "model_modes": ["*"],
        "transport": {"kind": "http_json", "method": "POST", "path": "/v1/responses", "port": "http", "timeout": "global", "response_codec": "json.v1"},
        "request": {"base": "identity", "hooks": [{"id": "llamacpp.tool_schema_limits", "params": {}}]},
        "response": {"hooks": [{"id": "llamacpp.client_model", "params": {}}]}
      },
      {
        "id": "chat.streaming",
        "operation": "chat_completion",
        "delivery": "streaming",
        "model_modes": ["*"],
        "transport": {"kind": "http_sse", "method": "POST", "path": "/v1/chat/completions", "port": "http", "timeout": "global", "stream_codec": "openai_sse.v1"},
        "request": {"base": "identity", "hooks": [
          {"id": "llamacpp.max_tokens_alias", "params": {}},
          {"id": "llamacpp.tool_schema_limits", "params": {}}
        ]}
      },
      {
        "id": "completion.streaming",
        "operation": "completion",
        "delivery": "streaming",
        "model_modes": ["*"],
        "transport": {"kind": "http_sse", "method": "POST", "path": "/v1/completions", "port": "http", "timeout": "global", "stream_codec": "openai_sse.v1"},
        "request": {"base": "identity"}
      },
      {
        "id": "responses.streaming",
        "operation": "responses",
        "delivery": "streaming",
        "model_modes": ["*"],
        "transport": {"kind": "http_sse", "method": "POST", "path": "/v1/responses", "port": "http", "timeout": "global", "stream_codec": "openai_sse.v1"},
        "request": {"base": "identity", "hooks": [{"id": "llamacpp.tool_schema_limits", "params": {}}]}
      },
      {
        "id": "embedding.buffered",
        "operation": "embeddings",
        "delivery": "buffered",
        "model_modes": ["*"],
        "transport": {"kind": "http_json", "method": "POST", "path": "/v1/embeddings", "port": "http", "timeout": "global", "response_codec": "json.v1"},
        "request": {"base": "identity"}
      },
      {
        "id": "reranking.buffered",
        "operation": "reranking",
        "delivery": "buffered",
        "model_modes": ["*"],
        "transport": {"kind": "http_json", "method": "POST", "path": "/v1/rerank", "port": "http", "timeout": "global", "response_codec": "json.v1"},
        "request": {"base": "identity"}
      },
      {
        "id": "slots.buffered",
        "operation": "slots",
        "delivery": "buffered",
        "model_modes": ["*"],
        "transport": {"kind": "http_json", "method": "GET", "path": "/slots", "port": "http", "timeout": "global", "response_codec": "json.v1"},
        "request": {"base": "identity"}
      },
      {
        "id": "slot-action.buffered",
        "operation": "slot_action",
        "delivery": "buffered",
        "model_modes": ["*"],
        "transport": {"kind": "http_json", "method": "POST", "path": "/slots/{slot_id}?action={action}", "port": "http", "timeout": "global", "response_codec": "json.v1"},
        "request": {"base": "identity"}
      },
      {
        "id": "tokenize.buffered",
        "operation": "tokenize",
        "delivery": "buffered",
        "model_modes": ["*"],
        "transport": {"kind": "http_json", "method": "POST", "path": "/tokenize", "port": "http", "timeout": "global", "response_codec": "json.v1"},
        "request": {"base": "identity"}
      }
    ],
    "hooks": {
      "backend": {"id": "llamacpp.backend.v1", "params": {}},
      "install_context": {"id": "llamacpp.install_context.v1", "params": {}},
      "launch": {"id": "llamacpp.prepare.v1", "params": {}},
      "runtime_options": {"id": "llamacpp.runtime_options.v1", "params": {}},
      "environment": {"id": "llamacpp.environment.v1", "params": {}},
      "system": {"id": "llamacpp.system.v1", "params": {}}
    },
    "rationale": []
  }
}
