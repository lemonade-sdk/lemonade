{
  "version": "1",
  "model_name": "user.Classifier-OnError",
  "recipe": "collection.router",
  "components": ["MathLLM", "CodingLLM", "DefaultLLM", "FailOpenModel", "FailClosedModel"],
  "routing": {
    "candidates": ["MathLLM", "CodingLLM", "DefaultLLM"],
    "default_model": "DefaultLLM",
    "classifiers": [
      { "id": "open",   "type": "classifier", "model": "FailOpenModel",   "labels": ["code"] },
      { "id": "closed", "type": "classifier", "model": "FailClosedModel", "labels": ["code"], "on_error": "match_true" }
    ],
    "rules": [
      { "id": "open-rule",   "match": { "classifier": "open",   "label": "code", "min_score": 0.5 }, "route_to": "CodingLLM" },
      { "id": "closed-rule", "match": { "classifier": "closed", "label": "code", "min_score": 0.5 }, "route_to": "MathLLM" }
    ]
  }
}
