{
  "version": "1",
  "model_name": "user.Conditions-TurnBounds",
  "recipe": "collection.router",
  "components": ["local", "cloud"],
  "routing": {
    "candidates": ["local", "cloud"],
    "default_model": "local",
    "rules": [
      { "id": "min_turns-rule",
        "match": { "min_turns": 3 },
        "route_to": "cloud" },
      { "id": "max_turns-rule",
        "match": { "max_turns": 1 },
        "route_to": "cloud" }
    ]
  }
}
