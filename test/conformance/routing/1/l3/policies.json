    "routing": {
      "candidates": ["MathLLM", "CodingLLM", "DefaultLLM"],
      "default_model": "DefaultLLM",
      "classifiers": [
        { "id": "topic", "type": "classifier", "model": "TopicModel", "labels": ["code"] }
      ],
      "rules": [
