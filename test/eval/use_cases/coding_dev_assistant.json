          "any": [
            {
              "regex": "\\bAKIA[0-9A-Z]{16}\\b"
            },
            {
              "regex": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b"
            },
            {
              "regex": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b"
            },
            {
              "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
            },
            {
              "regex": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b"
            },
            {
              "regex": "(api[_-]?key|API[_-]?KEY|secret|SECRET|password|PASSWORD|token|TOKEN)\\s*[:=]\\s*['\"][^'\"]{8,}['\"]"
            },
            {
              "regex": "\\b(10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3})\\b"
            },
            {
              "regex": "\\b[a-z0-9.-]+\\.(internal|corp|intranet)\\b"
            }
          ]
        },
        "route_to": "Qwen3.5-9B-GGUF",
        "outputs": {
          "reason": "credential-or-internal-host",
          "data_class": "secret"
        }
