{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "backend-definition-v2.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "id": {
      "$ref": "#/$defs/Identifier"
    },
    "recipe": {
      "$ref": "#/$defs/Identifier"
    },
    "extends": {
      "$ref": "#/$defs/BaseReference"
    },
    "merge": {
      "$ref": "#/$defs/MergePayload"
    },
    "edits": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/Edit"
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "recipe"
  ],
  "additionalProperties": false,
  "$defs": {
    "Hook": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "params"
      ],
      "additionalProperties": false
    },
    "Expression": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "object",
          "properties": {
            "literal": {}
          },
          "required": [
            "literal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string"
            },
            "type": {
              "enum": [
                "string",
                "integer",
                "number",
                "boolean"
              ]
            },
            "default": {}
          },
          "required": [
            "ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "concat": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expression"
              },
              "minItems": 1
            }
          },
          "required": [
            "concat"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "string": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [
            "string"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "coalesce": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expression"
              },
              "minItems": 1
            }
          },
          "required": [
            "coalesce"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "present": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [
            "present"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "eq": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expression"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "eq"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "gt": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expression"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "gt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expression"
              },
              "minItems": 1
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expression"
              },
              "minItems": 1
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "when": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expression"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "when"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "parent_path": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [
            "parent_path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "path_join": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expression"
              },
              "minItems": 1
            }
          },
          "required": [
            "path_join"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "option": {
              "$ref": "#/$defs/Identifier"
            },
            "type": {
              "enum": [
                "string",
                "integer",
                "number",
                "boolean"
              ]
            },
            "default": {}
          },
          "required": [
            "option"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Ui": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "control": {
          "enum": [
            "text",
            "textarea",
            "number",
            "checkbox",
            "select"
          ]
        },
        "order": {
          "type": "integer"
        },
        "choices": {
          "enum": [
            "supported_backends"
          ]
        }
      },
      "required": [
        "label",
        "control",
        "order"
      ],
      "additionalProperties": false
    },
    "Option": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "cli_flag": {
          "type": "string"
        },
        "default_value": {},
        "type_name": {
          "type": "string"
        },
        "value_type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean"
          ]
        },
        "help": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "enum": {
          "type": "array",
          "items": {}
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "unset_values": {
          "type": "array",
          "items": {}
        },
        "ui": {
          "$ref": "#/$defs/Ui"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "name",
        "default_value",
        "value_type",
        "id"
      ],
      "additionalProperties": false
    },
    "Support": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string"
        },
        "tier": {
          "enum": [
            "core",
            "experimental",
            "guest"
          ]
        },
        "format": {
          "enum": [
            "native",
            "python",
            "container"
          ]
        },
        "supported_os": {
          "type": "array",
          "items": {
            "enum": [
              "windows",
              "linux",
              "macos"
            ]
          }
        },
        "devices": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "device_summary": {
          "type": "string"
        },
        "arch_gates": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "os": {
                "type": "array",
                "items": {
                  "enum": [
                    "windows",
                    "linux",
                    "macos"
                  ]
                }
              },
              "channels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "os",
              "channels"
            ],
            "additionalProperties": false
          }
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "backend",
        "tier",
        "format",
        "supported_os",
        "devices",
        "device_summary",
        "id"
      ],
      "additionalProperties": false
    },
    "Metadata": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "server_name": {
          "type": "string"
        },
        "log_category": {
          "type": "string"
        },
        "log_level_policy": {
          "enum": [
            "passthrough",
            "debug_flag"
          ]
        },
        "binary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "windows": {
                  "type": "string"
                },
                "linux": {
                  "type": "string"
                },
                "macos": {
                  "type": "string"
                }
              },
              "required": [
                "windows",
                "linux",
                "macos"
              ],
              "additionalProperties": false
            }
          ]
        },
        "config_section": {
          "type": "string"
        },
        "default_device": {
          "enum": [
            "cpu",
            "gpu",
            "npu",
            "none"
          ]
        },
        "slot_policy": {
          "enum": [
            "standard",
            "exclusive_npu",
            "coexist_by_type",
            "unmetered"
          ]
        },
        "selectable_backend": {
          "type": "boolean"
        },
        "uses_ctx_size": {
          "type": "boolean"
        },
        "dynamic_models": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Option"
          }
        },
        "support": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Support"
          }
        },
        "supported_modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_checkpoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "web_display_name": {
          "type": "string"
        },
        "rocm_channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exposes_prometheus_metrics": {
          "type": "boolean"
        },
        "rocm_requires_cwsr_fix": {
          "type": "boolean"
        },
        "version_policy": {
          "enum": [
            "exact",
            "at_least"
          ]
        },
        "self_manages_downloads": {
          "type": "boolean"
        },
        "takes_args": {
          "type": "boolean"
        },
        "arg_variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bin_variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "config_extra": {
          "type": "object"
        },
        "streams_model_from_storage": {
          "type": "boolean"
        }
      },
      "required": [
        "display_name",
        "server_name",
        "binary"
      ],
      "additionalProperties": false
    },
    "InstallCase": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "os": {
          "type": "array",
          "items": {
            "enum": [
              "windows",
              "linux",
              "macos"
            ]
          }
        },
        "arch": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "machine_arch": {
          "type": "array",
          "items": {
            "enum": [
              "x86_64",
              "aarch64",
              ""
            ]
          }
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "$ref": "#/$defs/Expression"
        },
        "version_override": {
          "$ref": "#/$defs/Expression"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "repo",
        "filename",
        "id"
      ],
      "additionalProperties": false
    },
    "Install": {
      "type": "object",
      "properties": {
        "strategy": {
          "enum": [
            "github_release",
            "external_only",
            "none",
            "hook"
          ]
        },
        "install_recipe": {
          "type": "string"
        },
        "pin_recipe": {
          "type": "string"
        },
        "supports_split_archive": {
          "type": "boolean"
        },
        "asset_backend": {
          "enum": [
            "identity",
            "collapse_rocm_prefix"
          ]
        },
        "default_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InstallCase"
          }
        },
        "errors": {
          "type": "object",
          "properties": {
            "backend": {
              "$ref": "#/$defs/Expression"
            },
            "os": {
              "$ref": "#/$defs/Expression"
            },
            "missing_arch": {
              "$ref": "#/$defs/Expression"
            },
            "arch": {
              "$ref": "#/$defs/Expression"
            },
            "machine_arch": {
              "$ref": "#/$defs/Expression"
            },
            "no_case": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "hook": {
          "$ref": "#/$defs/Hook"
        },
        "repository_result": {
          "enum": [
            "repository_only",
            "full_params"
          ]
        },
        "fact_timing": {
          "enum": [
            "selected_case",
            "before_platform"
          ]
        },
        "repository_facts": {
          "type": "array",
          "items": {
            "enum": [
              "therock_version",
              "rocm_asset_family",
              "cuda_architecture"
            ]
          },
          "uniqueItems": true,
          "maxItems": 3
        },
        "unmanaged_backends": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "backend_fallback": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "strategy"
      ],
      "additionalProperties": false
    },
    "Artifact": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "strategy": {
          "enum": [
            "resolved_path",
            "hook"
          ]
        },
        "cache_resolution": {
          "enum": [
            "default",
            "active_snapshot",
            "sentinel_directory",
            "sentinel_file"
          ]
        },
        "import_resolution": {
          "enum": [
            "default",
            "sentinel_directory"
          ]
        },
        "absolute_checkpoint_fallback": {
          "type": "boolean"
        },
        "check": {
          "enum": [
            "exists",
            "nonempty"
          ]
        },
        "sentinel": {
          "type": "string"
        },
        "selection": {
          "enum": [
            "first_existing",
            "unique"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files_from": {
          "enum": [
            "variant_directory"
          ]
        },
        "files_error": {
          "$ref": "#/$defs/Expression"
        },
        "missing_error": {
          "$ref": "#/$defs/Expression"
        },
        "hook": {
          "$ref": "#/$defs/Hook"
        },
        "required_when": {
          "$ref": "#/$defs/Expression"
        }
      },
      "required": [
        "role",
        "strategy"
      ],
      "additionalProperties": false
    },
    "Launch": {
      "type": "object",
      "properties": {
        "prepare_order": {
          "type": "array",
          "items": {
            "enum": [
              "artifacts",
              "custom_args",
              "backend",
              "install",
              "hook",
              "program",
              "ports"
            ]
          },
          "minItems": 4,
          "maxItems": 7,
          "uniqueItems": true
        },
        "requires": {
          "type": "object",
          "properties": {
            "os": {
              "type": "array",
              "items": {
                "enum": [
                  "windows",
                  "linux",
                  "macos"
                ]
              }
            },
            "machine_arch": {
              "type": "array",
              "items": {
                "enum": [
                  "x86_64",
                  "aarch64"
                ]
              }
            },
            "error": {
              "type": "string"
            }
          },
          "required": [
            "error"
          ],
          "additionalProperties": false
        },
        "backend": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "fixed": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "windows": {
                          "type": "string"
                        },
                        "linux": {
                          "type": "string"
                        },
                        "macos": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "windows",
                        "linux",
                        "macos"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "fixed"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "option": {
                  "$ref": "#/$defs/Identifier"
                },
                "fallback": {
                  "enum": [
                    "first_supported"
                  ]
                },
                "on_empty": {
                  "type": "object",
                  "properties": {
                    "operation": {
                      "type": "string"
                    },
                    "target": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "operation",
                    "target"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "option",
                "fallback",
                "on_empty"
              ],
              "additionalProperties": false
            }
          ]
        },
        "program": {
          "type": "object",
          "properties": {
            "source": {
              "enum": [
                "managed",
                "external_or_managed"
              ]
            },
            "install_policy": {
              "enum": [
                "always"
              ]
            },
            "missing_error": {
              "$ref": "#/$defs/Expression"
            }
          },
          "required": [
            "source",
            "install_policy"
          ],
          "additionalProperties": false
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          },
          "minItems": 1
        },
        "argv": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArgvRecord"
          }
        },
        "custom_args": {
          "type": "object",
          "properties": {
            "option": {
              "$ref": "#/$defs/Identifier"
            },
            "reserved": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "error_prefix": {
              "type": "string"
            },
            "defaults": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CustomArgDefault"
              }
            },
            "runtime_input": {
              "enum": [
                "preserve",
                "string_or_empty"
              ]
            }
          },
          "required": [
            "option",
            "reserved",
            "error_prefix"
          ],
          "additionalProperties": false
        },
        "environment": {
          "type": "object",
          "properties": {
            "preset": {
              "enum": [
                "inherit",
                "executable_loader_path",
                "posix_executable_loader_path",
                "bundled_accelerator_runtime",
                "hook"
              ]
            },
            "order": {
              "enum": [
                "preset_first",
                "set_first"
              ]
            },
            "set": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EnvironmentSet"
              }
            }
          },
          "required": [
            "preset"
          ],
          "additionalProperties": false
        },
        "working_directory": {
          "$ref": "#/$defs/WorkingDirectory"
        },
        "output": {
          "type": "object",
          "properties": {
            "inherit_levels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "filter": {
              "type": "boolean"
            }
          },
          "required": [
            "inherit_levels",
            "filter"
          ],
          "additionalProperties": false
        },
        "readiness": {
          "type": "object",
          "properties": {
            "port": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "timeout": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "enum": [
                    "global"
                  ]
                }
              ]
            }
          },
          "required": [
            "port",
            "path",
            "timeout"
          ],
          "additionalProperties": false
        },
        "watchdog": {
          "type": "object",
          "properties": {
            "policy": {
              "enum": [
                "standard",
                "none"
              ]
            },
            "port": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "policy",
            "port",
            "path"
          ],
          "additionalProperties": false
        },
        "context_floor": {
          "type": "object",
          "properties": {
            "llm": {
              "type": "integer",
              "minimum": 0
            },
            "embedding": {
              "type": "integer",
              "minimum": 0
            },
            "reranking": {
              "type": "integer",
              "minimum": 0
            },
            "transcription": {
              "type": "integer",
              "minimum": 0
            },
            "image": {
              "type": "integer",
              "minimum": 0
            },
            "tts": {
              "type": "integer",
              "minimum": 0
            },
            "audio-generation": {
