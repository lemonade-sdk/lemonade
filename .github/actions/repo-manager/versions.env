# Everything the repo-manager job depends on, pinned in one place. The image build
# (.github/workflows/build-repo-manager-container.yml) builds from these, the action runs
# from them, and the image carries a copy of this file, so a bump cannot leave the image
# and the job that uses it disagreeing about what is installed.
#
# Bumping any of these publishes a new image on merge to main. Until that finishes, jobs
# build the image on the runner instead, so a bump is never blocked on the registry.
REPO_MANAGER_VERSION=v1.0.3
REPO_MANAGER_MODEL=Qwen3.6-35B-A3B-MTP-GGUF
LEMONADE_VERSION=11.9.0
GH_CLI_VERSION=2.101.0
NODE_VERSION=22.20.0
