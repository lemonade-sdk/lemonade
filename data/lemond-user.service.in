[Unit]
Description=Lemonade Server (user)
Documentation=https://lemonade-server.ai/docs/
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
# Optional env file for HF_TOKEN / LEMONADE_API_KEY / LEMONADE_ADMIN_API_KEY.
# %E expands to $XDG_CONFIG_HOME (default ~/.config). `systemctl --user edit
# lemond` drop-ins work too.
EnvironmentFile=-%E/lemonade/lemond.conf
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/lemond
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT

# Rootless Podman needs the setuid newuidmap/newgidmap helpers and the user's
# full subordinate ID range. In a user manager each sandboxing option takes one
# of them away, so the service runs with the user's own rights, as a lemond
# started from a shell does.

[Install]
WantedBy=default.target
