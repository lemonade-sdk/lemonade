# Base URL of your locally running Lemonade Server.
# This value is read on the Next.js server only and is never exposed to the browser.
LEMONADE_SERVER_URL=http://127.0.0.1:13305

# Display name shown in the application shell.
NEXT_PUBLIC_APP_NAME=AI Campus Copilot Local

# Optional. Set this only if your Lemonade Server was started with LEMONADE_API_KEY.
# Leave it unset for a default local install, which needs no key.
# LEMONADE_API_KEY=
