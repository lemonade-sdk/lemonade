#!/bin/sh
# Vendor the cpp-httplib source that the Nexus SDK builds against into
# debian/httplib-vendor, so the package builds without network access.
# Distributions ship cpp-httplib older than the SDK needs (it uses the
# WebSocket client and the TLS context API of 0.61.0). lemond itself keeps
# the system package; the SDK is its own library with hidden symbols.
# Run from the source root before building the source or binary package.
set -eu

tag=v0.61.0
commit=c419c904da4ed0d057f169c225c58cc795c07e4d
out=debian/httplib-vendor

# The SDK's own FetchContent pin names the version it needs. A re-vendor that
# moves it must move this script too.
sdk_tag=$(sed -n 's/^[[:space:]]*GIT_TAG[[:space:]]*\(v[0-9.]*\).*/\1/p' \
    src/LemonadeNexusSDK/cmake/libraries/httplib.cmake)
if [ "$sdk_tag" != "$tag" ]; then
    echo "vendor-httplib: the Nexus SDK pins cpp-httplib $sdk_tag; this script vendors $tag" >&2
    exit 1
fi

rm -rf "$out"
git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$tag" https://github.com/yhirose/cpp-httplib.git "$out"
actual=$(git -C "$out" rev-parse HEAD)
if [ "$actual" != "$commit" ]; then
    echo "vendor-httplib: $tag is $actual, expected $commit" >&2
    rm -rf "$out"
    exit 1
fi
# The CMake build needs only these; tests, examples and docs are most of the size.
find "$out" -mindepth 1 -maxdepth 1 \
    ! -name CMakeLists.txt ! -name cmake ! -name httplib.h ! -name LICENSE \
    -exec rm -rf {} +
du -sh "$out"
